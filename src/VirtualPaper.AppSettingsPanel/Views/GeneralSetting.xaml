<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.AppSettingsPanel.Views.GeneralSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:VirtualPaper.UIComponent.Layout"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.AppSettingsPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollView>
        <StackPanel Margin="16 12 16 16" Spacing="16" Orientation="Vertical">
            <StackPanel x:Name="Version" Spacing="8" Orientation="Vertical">
                <TextBlock x:Name="VersionHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_General_Text_Version_Text"
                    FontWeight="Bold"/>

                <layout:ArcExpander x:Name="VersionExpander"
                    Margin="0"
                    Padding="20 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <layout:ArcExpander.Header>
                        <Grid Height="90">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Margin="0 0 20 0" Glyph="&#xE117;"/>
                            
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{x:Bind _viewModel.AppVersionText}" FontSize="16"/>
                                <TextBlock 
                                    Grid.Row="1" 
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind _viewModel.Version_LastCheckDate, Mode=OneWay}"/>
                                <HyperlinkButton
                                    Grid.Row="2"
                                    l:Uids.Uid="Ui_Settings_General_Version_Release_Notes_Content"
                                    Margin="0"
                                    Padding="0"
                                    NavigateUri="https://github.com/PaperHammer/VirtualPaper/releases"/>
                            </Grid>

                            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <ProgressRing x:Name="UpdateProgressRing"
                                    IsActive="{x:Bind _viewModel.IsUpdateRingActive, Mode=OneWay}"
                                    Margin="40 0"
                                    Background="Transparent"/>
                                <Button x:Name="VersionCheckUpdate"
                                    Grid.Column="1" 
                                    Width="200"
                                    HorizontalAlignment="Stretch"
                                    l:Uids.Uid="Ui_Settings_General_Version_UpdateCheck_Content"
                                    IsEnabled="{x:Bind _viewModel.IsUpdateBtnEnable, Mode=OneWay}"
                                    Command="{x:Bind _viewModel.CheckUpdateCommand}"
                                    Visibility="{x:Bind _viewModel.IsWinStore, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}"/>
                            </Grid>
                        </Grid>
                    </layout:ArcExpander.Header>
                    <layout:ArcExpander.Content>
                        <StackPanel Orientation="Vertical" Margin="35 10 35 10"
                            Visibility="{x:Bind _viewModel.PluginVersionsVisibility}">
                            <TextBlock l:Uids.Uid="Ui_Settings_General_Version_Plugins_Text"
                                FontWeight="SemiBold" Margin="0 0 0 5"/>
                            <ItemsRepeater ItemsSource="{x:Bind _viewModel.PluginVersionTexts, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Margin="0 2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•" Margin="0 0 8 0" 
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind}" 
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </layout:ArcExpander.Content>
                </layout:ArcExpander>

                <InfoBar x:Name="InfoBarFindNew"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=FindNew}"
                    l:Uids.Uid="Ui_Settings_General_Version_FindNew_Title"
                    Message="{x:Bind _viewModel.Version, Mode=OneWay}" >
                    <InfoBar.Content>
                        <Grid Padding="10 0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Button
                                Width="100"
                                l:Uids.Uid="Ui_Settings_General_Version_DownloadStart_Content"
                                IsEnabled="{x:Bind _viewModel.IsUpdateBtnEnable, Mode=OneWay}"
                                Command="{x:Bind _viewModel.StartDownloadComand}"/>

                            <HyperlinkButton
                                Grid.Column="1"
                                l:Uids.Uid="Ui_Settings_General_Version_SeeNews_Content"
                                HorizontalAlignment="Right"
                                NavigateUri="https://github.com/PaperHammer/VirtualPaper/releases"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar x:Name="InfoBarNetErr"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=UpdateErr}"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    l:Uids.Uid="Ui_Settings_General_Version_UpdateErr_Title"/>

                <InfoBar x:Name="InfoBarUptoNewest"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=UptoNewest}"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Success"
                    l:Uids.Uid="Ui_Settings_General_Version_UptoNewest_Title" >
                </InfoBar>

                <InfoBar x:Name="InfoBarUpdateReady"
                    Visibility="{x:Bind _viewModel.CurrentVersionState, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=InstallReady}"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Success"
                    Title="{x:Bind _viewModel.Text_UpdateReady, Mode=OneWay}"
                    Message="{x:Bind _viewModel.Version, Mode=OneWay}" >
                    <InfoBar.Content>
                        <Grid Padding="10 0" Margin="0 0 0 10">
                            <Button
                                Width="100"
                                l:Uids.Uid="Ui_Settings_General_Version_Install_Content"
                                IsEnabled="{x:Bind _viewModel.IsInstallBtnEnable, Mode=OneWay}"                                
                                Command="{x:Bind _viewModel.InstallBtnComand}"/>
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>

            <StackPanel x:Name="AppearanceAndAction"
                Spacing="8"
                Orientation="Vertical">

                <TextBlock x:Name="AppearanceAndActionHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_General_Text_AppearanceAndAction_Text"
                    FontWeight="Bold"/>

                <Grid x:Name="AutoStart"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE768;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AutoStart_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AutoStatExplain_Text"/>
                    </Grid>

                    <ToggleButton
                        Grid.Column="2"
                        Width="200"
                        AutomationProperties.AutomationId="Settings.General.AutoStart"
                        Content="{x:Bind _viewModel.AutoStartStatu, Mode=OneWay}"
                        IsChecked="{x:Bind _viewModel.IsAutoStart, Mode=TwoWay}"/>
                </Grid>

                <Grid x:Name="SystemBackdrop"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE727;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppSystemBackdrop_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppSystemBackdropExplain_Text"/>
                        <StackPanel
                            Grid.Row="2"
                            Margin="0"
                            Padding="0"
                            Orientation="Horizontal">
                            <HyperlinkButton 
                                Margin="0"
                                Padding="0"
                                l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppSystemBackdrop_Mica_Hyperlink_Content"
                                NavigateUri="https://learn.microsoft.com/en-us/windows/apps/design/style/mica"/>
                            <HyperlinkButton 
                                Margin="15 0 0 0"
                                Padding="0"
                                l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppSystemBackdrop_Acrylic_Hyperlink_Content"
                                NavigateUri="https://learn.microsoft.com/en-us/windows/apps/design/style/acrylic"/>
                        </StackPanel>

                    </Grid>

                    <ComboBox x:Name="AppSystemBackdropCombo"
                        AutomationProperties.AutomationId="Settings.General.Backdrop"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.SystemBackdrops, Mode=OneWay}"
                        SelectedIndex="{x:Bind _viewModel.SeletedSystemBackdropIndx, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid MinHeight="90" Padding="20 12"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Margin="0 0 20 0" Glyph="&#xE7F4;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 20 0">
                        <TextBlock l:Uids.Uid="Ui_Settings_General_IntelligentResultReminder_Text"/>
                        <TextBlock l:Uids.Uid="Ui_Settings_General_IntelligentResultReminder_Description"
                            TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Width="200" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Settings.General.IntelligentResultReminder"
                        Content="{x:Bind _viewModel.IntelligentResultReminderStatus, Mode=OneWay}"
                        IsChecked="{x:Bind _viewModel.RemindUnpreservedIntelligentResults, Mode=TwoWay}"
                        l:Uids.Uid="Ui_Settings_General_IntelligentResultReminder_AutomationName"/>
                </Grid>

                <Grid x:Name="Language"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xF2B7;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppLanguage_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppLanguageExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="AppLanguageCombo"
                        IsEnabled="{x:Bind _viewModel.IsLanguageChangeEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="Settings.General.Language"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.Languages}"
                        SelectedItem="{x:Bind _viewModel.SelectedLanguage, Mode=TwoWay}"
                        DisplayMemberPath="Language"
                        SelectedValuePath="Language"
                        Width="200" />
                </Grid>

                <layout:ArcExpander x:Name="FileStorage"
                    Margin="0"
                    Padding="20 0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <layout:ArcExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Margin="0 0 20 0" Glyph="&#xE8B7;"/>

                            <Grid Margin="0 25" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppFileStorage_Text"/>
                                <TextBlock
                                    Grid.Row="1"                                        
                                    l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppFileStorageExplain_Text"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </Grid>
                    </layout:ArcExpander.Header>
                    <layout:ArcExpander.Content>
                        <StackPanel Orientation="Vertical" Margin="35 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="FileStorageButton"
                                    l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppFileStorage_ModifyTooltip_ToolTipService_ToolTip"
                                    Content="{x:Bind _viewModel.WallpaperDir, Mode=OneWay}"
                                    IsEnabled="{x:Bind _viewModel.IsWallpaperDirectoryChangeEnable, Mode=OneWay}"
                                    MaxWidth="700"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Bind _viewModel.ChangeFileStorageCommand}"/>

                                <Button x:Name="OpenFileStorageButton"
                                    Grid.Column="1"
                                    Margin="10 0"
                                    l:Uids.Uid="Ui_Settings_General_AppearanceAndAction_AppFileStorage_OpenTooltip_ToolTipService_ToolTip"
                                    Command="{x:Bind _viewModel.OpenFileStorageCommand}">
                                    <Button.Content>
                                        <FontIcon Glyph="&#xE838;" />
                                    </Button.Content>
                                </Button>

                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    Grid.Column="2"
                                    IsActive="{x:Bind _viewModel.WallpaperDirectoryChangeOngoing, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </layout:ArcExpander.Content>
                </layout:ArcExpander>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
