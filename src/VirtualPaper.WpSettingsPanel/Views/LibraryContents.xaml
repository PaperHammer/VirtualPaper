<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.WpSettingsPanel.Views.LibraryContents"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.WpSettingsPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VirtualPaper.Models.Cores.Interfaces"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    NavigationCacheMode="Enabled">

    <arc:ArcPage.Resources>
        <Style x:Key="LibGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0 0 12 12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="rootGrid"
                            Background="Transparent"
                            Loaded="GridViewItem_Loaded"
                            PointerEntered="GridViewItem_PointerEntered"
                            PointerExited="GridViewItem_PointerExited"
                            PointerCanceled="GridViewItem_PointerCanceled">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionOverlay.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionOverlay.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionOverlay.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter x:Name="contentPresenter"
                                RenderTransformOrigin="0.5 0.5"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.RenderTransform>
                                    <CompositeTransform x:Name="ContentPresenterTransform" ScaleX="1" ScaleY="1"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>

                            <Border x:Name="SelectionOverlay"
                                Opacity="0"
                                IsHitTestVisible="False"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="3"
                                CornerRadius="8">
                                <Border
                                    Width="26"
                                    Height="26"
                                    Margin="8"
                                    Padding="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="13">
                                    <FontIcon
                                        Glyph="&#xE73E;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WallpaperItemTemplate" x:DataType="models:IWpBasicData">
            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="8"
                ContextFlyout="{StaticResource WallpaperContextFlyout}">

                <!-- 原生占位缩略图：无 preview（ThumbnailPath 为空）或图片加载失败时显示 -->
                <Grid x:Name="NoPreviewPlaceholder"
                    Visibility="{x:Bind ThumbnailPath, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Opacity="0.65">
                        <FontIcon Glyph="&#xEB9F;" FontSize="36"/>
                        <TextBlock
                            l:Uids.Uid="Ui_Text_NoPreview_Text"
                            FontSize="12"
                            TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Image 
                    Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}}"
                    Stretch="UniformToFill"
                    ImageFailed="Image_ImageFailed"/>

                <Border 
                    VerticalAlignment="Bottom"
                    Padding="10 18 10 10"
                    Height="72">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#D9000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        MaxLines="2"
                        FontSize="16"
                        LineHeight="20"
                        VerticalAlignment="Bottom"
                        Foreground="White"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WallpaperItemsPanel">
            <ItemsWrapGrid x:Name="InternalItemsWrapGrid"
                Orientation="Horizontal" 
                VerticalAlignment="Top"
                HorizontalAlignment="Left"/>
        </ItemsPanelTemplate>

        <MenuFlyout x:Key="WallpaperContextFlyout"
            ShowMode="Transient"
            Opening="WallpaperContextFlyout_Opening">
            <MenuFlyoutItem
                Tag="Details"
                l:Uids.Uid="Ui_Text_Details_Text"
                Click="ContextMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Tag="UpdateConfig"
                AutomationProperties.AutomationId="Library.Item.Update"
                l:Uids.Uid="Ui_Text_UpdateConfig_Text"
                Click="ContextMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE753;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Tag="Edit"
                l:Uids.Uid="Ui_Text_Edit_Text"
                Click="ContextMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem 
                Tag="Preview"                         
                l:Uids.Uid="Ui_Text_Preview_Text"
                Click="ContextMenu_Click" >
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE890;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem 
                Tag="Apply" 
                AutomationProperties.AutomationId="Library.Item.Apply"
                l:Uids.Uid="Ui_Text_Apply_Text"
                Click="ContextMenu_Click" >
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8FB;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem 
                Tag="LockBackground" 
                l:Uids.Uid="Ui_Text_ApplyToLockBG_Text"
                Click="ContextMenu_Click" >
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEE3F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Tag="ShowOnDisk"
                l:Uids.Uid="Ui_Text_ShowOnDisk_Text"
                Click="ContextMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xED25;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Tag="RemoveFromLib"
                AutomationProperties.AutomationId="Library.Item.Delete"
                l:Uids.Uid="Ui_Text_RemoveFromLib_Text"
                Click="ContextMenu_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" Foreground="Goldenrod"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </arc:ArcPage.Resources>

    <ScrollView x:Name="wallpaperLibScrollViewer"
         HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
         Padding="12 0 12 0" Margin="0 0 0 20"
         ViewChanged="WallpaperLibScrollViewer_ViewChanged">
        <StackPanel
            Orientation="Vertical"
            Spacing="8">
            <GridView x:Name="wallpapersLibView"
                AutomationProperties.AutomationId="Library.Items"
                ContainerContentChanging="WallpapersLibView_ContainerContentChanging"
                ContextRequested="WallpapersLibView_ContextRequested"
                Margin="0 0 -12 0"
                SizeChanged="WallpapersLibView_SizeChanged"
                DataContext="{x:Bind _viewModel}"
                ItemsSource="{x:Bind _viewModel.LibraryWallpapers}"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                AllowDrop="True"
                DragOver="WallpapersLibView_DragOver"
                Drop="WallpapersLibView_Drop"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                ItemClick="WallpapersLibView_ItemClick"
                IsItemClickEnabled="True"
                SelectionMode="None"
                SelectionChanged="WallpapersLibView_SelectionChanged"
                ItemContainerStyle="{StaticResource LibGridViewItemStyle}"
                ItemTemplate="{StaticResource WallpaperItemTemplate}"
                ItemsPanel="{StaticResource WallpaperItemsPanel}"
                PreviewKeyDown="WallpapersLibView_PreviewKeyDown">
            </GridView>

            <Grid HorizontalAlignment="Center">
                <ProgressRing Height="20" Width="20"
                    Visibility="{x:Bind _viewModel.LibLoadingStatus, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=Changing}"/>
                <TextBlock l:Uids.Uid="Ui_Lib_NotAnyMore_Text" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="{x:Bind _viewModel.LibLoadingStatus, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=Ready}"/>
            </Grid>
        </StackPanel>
    </ScrollView>
</arc:ArcPage>
