<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.StaticImg.Views.Tools.SelectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:VirtualPaper.UIComponent.Layout"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Workloads.Creation.StaticImg.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <layout:ArcExpander Style="{StaticResource RightExpanderStyle}">
        <layout:ArcExpander.Header>
            <TextBlock l:Uids.Uid="Ui_Project_StaticImg_ToolName_Selection_Text"/>
        </layout:ArcExpander.Header>
        <layout:ArcExpander.Content>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    l:Uids.Uid="Ui_Text_Cancel_Content"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    Click="SelectCancelBtn_Click"/>

                <Button 
                    Grid.Column="2"
                    l:Uids.Uid="Ui_Text_Complete_Content"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="SelectCommitBtn_Click"/>
            </Grid>
        </layout:ArcExpander.Content>
    </layout:ArcExpander>
</UserControl>
