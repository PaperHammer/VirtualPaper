<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.WpSettingsPanel.Views.ScreenSaver"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded" NavigationCacheMode="Enabled">
    <arc:ArcPage.Resources>
        <MenuFlyout x:Key="MF_FilteredListView">
            <MenuFlyoutItem l:Uids.Uid="Ui_ScreenSaver_Remove_Text" Click="RightClickMenuItem_Click"/>
        </MenuFlyout>
        <Style x:Key="WhitelistItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </arc:ArcPage.Resources>

    <ScrollView>
        <StackPanel x:Name="VirtualPaperScreenSaver" Margin="16 12 16 16" Spacing="16">
            <Expander Padding="20 0" CornerRadius="12"
                AutomationProperties.AutomationId="ScreenSaver.Options"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Expander.Header>
                    <Grid MinHeight="90" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF182;" FontSize="20"/>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0 12 0 12" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Ui_ScreenSaver_Server_Text" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_ScreenSaver_ServerExplain_Text" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Width="200" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ScreenSaver.Enabled"
                            Content="{x:Bind _viewModel.ScreenSaverStatu, Mode=OneWay}"
                            IsChecked="{x:Bind _viewModel.IsScreenSaverOn, Mode=TwoWay}"
                            l:Uids.Uid="Ui_ScreenSaver_Server_AutomationProperties_Name"/>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <ContentControl IsEnabled="{x:Bind _viewModel.IsScreenSaverOn, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="44 4 0 16" Spacing="16">
                            <NumberBox Width="200" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ScreenSaver.WaitMinutes"
                                l:Uids.Uid="Ui_ScreenSaver_WaitingTime_Header"
                                Value="{x:Bind _viewModel.WaitingTime, Mode=TwoWay}"
                                SpinButtonPlacementMode="Inline" Minimum="1" Maximum="60" SmallChange="1" LargeChange="1"/>
                            <CheckBox IsChecked="{x:Bind _viewModel.IsRunningLock, Mode=TwoWay}">
                                <StackPanel Spacing="4">
                                    <TextBlock l:Uids.Uid="Ui_ScreenSaver_RunningLock_Text" TextWrapping="Wrap"/>
                                    <TextBlock l:Uids.Uid="Ui_ScreenSaver_RunningLockExplain_Text" TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel x:Name="DynamicEffects" Spacing="4">
                                <TextBlock l:Uids.Uid="Ui_ScreenSaver_DynamicEffects_Text"/>
                                <TextBlock l:Uids.Uid="Ui_ScreenSaver_DynamicEffectsExplain_Text" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="DynamicEffectsCombo" Width="200" Margin="0 4 0 0"
                                    AutomationProperties.AutomationId="ScreenSaver.Effect"
                                    ItemsSource="{x:Bind _viewModel.Effects, Mode=OneWay}"
                                    SelectedIndex="{x:Bind _viewModel.SeletedEffectIndx, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </Expander.Content>
            </Expander>

            <Border x:Name="WhiteList" Padding="20" CornerRadius="12"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock l:Uids.Uid="Ui_ScreenSaver_WhiteListTitle_Text" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Ui_ScreenSaver_WhiteListExplain_Text" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetProName" Width="360"
                            AutomationProperties.AutomationId="ScreenSaver.Whitelist.Search"
                            VerticalAlignment="Center"
                            l:Uids.Uid="Ui_ScreenSaver_SeekFromList_PlaceholderText__ScreenSaver_SeekFromList_AutomationProperties_Name"

                            TextChanged="OnFilterChanged"/>
                        <Button Grid.Column="1" MinWidth="120" Padding="12 8" CornerRadius="8"
                            AutomationProperties.AutomationId="ScreenSaver.Whitelist.Add"
                            Command="{x:Bind _viewModel.AddToWhiteListCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock l:Uids.Uid="Ui_ScreenSaver_Add_Text"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="FilteredListView" MaxHeight="360"
                        AutomationProperties.AutomationId="ScreenSaver.Whitelist.Items"
                        ItemsSource="{x:Bind _viewModel.ProcsFiltered}" SelectionMode="Single"
                        ItemContainerStyle="{StaticResource WhitelistItemStyle}"
                        ShowsScrollingPlaceholders="True" BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" ContextFlyout="{StaticResource MF_FilteredListView}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <BitmapIcon Width="36" Height="36" UriSource="{Binding IconPath}" ShowAsMonochrome="False"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProcPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                            AutomationProperties.AutomationId="ScreenSaver.Whitelist.Path"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding ProcPath}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="36" Height="36" Padding="8" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ScreenSaver.Whitelist.Remove"
                                        Click="RemoveWhiteListItem_Click" l:Uids.Uid="Ui_ScreenSaver_Remove_ToolTipService_ToolTip__ScreenSaver_Remove_AutomationProperties_Name"
                                        >
                                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="WhiteListEmptyState" Padding="24" Spacing="8" MinHeight="180"
                        VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE721;" FontSize="32" Margin="0 8"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="EmptyListTitle"
                            AutomationProperties.AutomationId="ScreenSaver.Whitelist.EmptyTitle"
                            FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyListDescription"
                            TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollView>
</arc:ArcPage>
