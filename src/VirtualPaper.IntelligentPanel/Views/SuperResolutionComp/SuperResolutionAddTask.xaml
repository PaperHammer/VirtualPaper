<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.IntelligentPanel.Views.SuperResolutionComp.SuperResolutionAddTask"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.IntelligentPanel.Views.SuperResolutionComp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lcl_models="using:VirtualPaper.IntelligentPanel.Models"
    xmlns:uicomp_utils="using:VirtualPaper.UIComponent.Utils"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Grid x:Name="addTaskGrid"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectorColumn.Width" Value="Auto"/>
                        <Setter Target="OptionsColumn.Width" Value="*"/>
                        <Setter Target="ConnectorPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="ConnectorPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="ConnectorPanel.Margin" Value="20,-40,20,0"/>
                        <Setter Target="ConnectorIconRotation.Angle" Value="0"/>
                        <Setter Target="OptionsPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="OptionsPanel.(Grid.Column)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ConnectorColumn" Width="0"/>
            <ColumnDefinition x:Name="OptionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Stretch" MaxWidth="420" Spacing="6">

            <TextBlock 
                l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Text"
                MinHeight="36" TextWrapping="Wrap" TextAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="4 3"
                    Fill="Transparent"/>

                <Button x:Name="sourceImageBorder" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="Intelligent.SuperResolution.Source"
                    l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Import_AutomationProperties_Name"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch"
                    Height="250"
                    Margin="10"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    uicomp_utils:CursorUtil.CursorShape="Hand"
                    Click="SourceImageButton_Click">
                    <Grid>
                        <StackPanel 
                            HorizontalAlignment="Stretch"
                            Margin="16"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}">
                            <FontIcon 
                                Glyph="&#xE8B9;"
                                FontSize="28"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Import_Text"
                                TextWrapping="Wrap" TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="14"/>
                        </StackPanel>

                        <Image x:Name="sourceImage"
                            Stretch="UniformToFill"
                            Source="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                    </Grid>
                </Button>
            </Grid>

            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE809;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileResolution, Mode=OneWay}" 
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileSize, Mode=OneWay}" 
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileExt, Mode=OneWay}" 
                        FontSize="14" 
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="ConnectorPanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            Margin="0,16">
            <Border 
                Width="48"
                Height="48"
                CornerRadius="14"
                Background="{ThemeResource AccentButtonBackground}"
                BorderBrush="{ThemeResource AccentButtonBorderBrush}"
                BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon 
                    Glyph="&#xE72A;"
                    FontSize="20"
                    Foreground="{ThemeResource AccentButtonForeground}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform><RotateTransform x:Name="ConnectorIconRotation" Angle="90"/></FontIcon.RenderTransform>
                </FontIcon>
            </Border>
        </Grid>

        <StackPanel x:Name="OptionsPanel"
            Grid.Row="2"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            MaxWidth="420"
            Spacing="12">

            <TextBlock 
                l:Uids.Uid="Ui_Intelligent_Enhance_Mode_Text"
                MinHeight="36" TextWrapping="Wrap" TextAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <Border
                HorizontalAlignment="Stretch"
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="16">

                    <RadioButton x:Name="qualityRestoreRadio"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Intelligent.SuperResolution.Restore"
                        GroupName="EnhanceMode"
                        IsChecked="{x:Bind _viewModel.IsQualityRestoreMode, Mode=TwoWay}"
                        Checked="EnhanceMode_Changed">
                        <StackPanel Spacing="2">
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Enhance_QualityRestore_Text"
                                TextWrapping="Wrap"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Enhance_QualityRestore_Desc_Text"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>

                    <Border 
                        Height="1" 
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        HorizontalAlignment="Stretch"/>

                    <RadioButton x:Name="superResolutionRadio"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Intelligent.SuperResolution.Enhance"
                        GroupName="EnhanceMode"
                        IsChecked="{x:Bind _viewModel.IsSuperResolutionMode, Mode=TwoWay}"
                        Checked="EnhanceMode_Changed">
                        <StackPanel Spacing="2">
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Enhance_SuperResolution_Text"
                                TextWrapping="Wrap"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Enhance_SuperResolution_Desc_Text"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>

                    <StackPanel 
                        Spacing="10"
                        Margin="28,0,0,0"
                        Visibility="{x:Bind _viewModel.IsSuperResolutionMode, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">

                        <TextBlock 
                            l:Uids.Uid="Ui_Intelligent_Enhance_Magnification_Text"
                            TextWrapping="Wrap"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="mag2xRadio"
                                AutomationProperties.AutomationId="Intelligent.SuperResolution.2x"
                                GroupName="Magnification"
                                Content="2×"
                                MinWidth="60"
                                IsChecked="{x:Bind _viewModel.IsMag2x, Mode=TwoWay}"
                                Checked="Magnification_Changed"
                                Style="{ThemeResource DefaultToggleButtonStyle}"/>
                            <RadioButton x:Name="mag4xRadio"
                                AutomationProperties.AutomationId="Intelligent.SuperResolution.4x"
                                GroupName="Magnification"
                                Content="4×"
                                MinWidth="60"
                                IsChecked="{x:Bind _viewModel.IsMag4x, Mode=TwoWay}"
                                Checked="Magnification_Changed"
                                Style="{ThemeResource DefaultToggleButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="12,10"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind _viewModel.OutputResolutionText, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE809;"
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            l:Uids.Uid="Ui_Intelligent_Enhance_Output_Text"
                            Grid.Column="1" TextWrapping="Wrap"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="Intelligent.SuperResolution.OutputSize"
                        Text="{x:Bind _viewModel.OutputResolutionText, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Grid>
            </Border>

            <Grid
                Padding="4,4" 
                ColumnSpacing="8"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon 
                    Glyph="&#xE946;"
                    FontSize="13"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"/>
                <TextBlock 
                    l:Uids.Uid="Ui_Intelligent_Enhance_Tip_Text"
                    Grid.Column="1"
                    FontSize="12"
                    TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>
    </Grid>
</arc:ArcPage>
