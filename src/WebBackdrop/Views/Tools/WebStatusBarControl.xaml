<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebStatusBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Height="28" Padding="8 0" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock
                FontSize="11"
                Opacity="0.7"
                VerticalAlignment="Center"
                Text="{x:Bind ActiveFilePath, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"/>

            <Line
                VerticalAlignment="Center"
                X1="0" Y1="0" X2="0" Y2="16"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>

            <TextBlock
                FontSize="11"
                Opacity="0.7"
                VerticalAlignment="Center"
                Text="{x:Bind ActiveFileLanguage, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            Spacing="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Button
                Padding="8 2"
                BorderThickness="0"
                Background="Transparent"
                ToolTipService.ToolTip="Preview in new window (Ctrl+Shift+P)"
                Click="Preview_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8FF;" FontSize="13"/>
                    <TextBlock FontSize="11" Text="Preview"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
