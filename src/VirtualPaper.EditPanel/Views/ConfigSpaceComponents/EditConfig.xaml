<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.EditPanel.Views.ConfigSpaceComponents.EditConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VirtualPaper.EditPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:edit="using:VirtualPaper.Models.EditPanel"
    xmlns:styles="using:VirtualPaper.UIComponent.Styles"
    xmlns:markup="using:VirtualPaper.UIComponent.ArcMarkupExtension"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="AvailableItemTemplate" x:DataType="edit:ProjectTemplate">
            <ListViewItem>
                <Grid Margin="0 10 10 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <styles:ArcImageIcon
                        Width="40"
                        ResourceKey="{x:Bind ItemImageKey}"
                        Margin="0 0 10 0"/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="14"
                        Margin="0 -2 0 0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Converter={StaticResource LocalizeConv}}"/>
                </Grid>
            </ListViewItem>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="gridEditConfig">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="{markup:I18n Key=Project_TemplateConfig}" FontSize="20"/>

        <Grid x:Name="gridAvailableTemplates" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.60*"/>
                <ColumnDefinition Width="0.04*"/>
                <ColumnDefinition Width="0.36*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="gridTemplates">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="tbSearchName"
                    Margin="0 20 0 0"
                    Height="30"
                    Width="340"
                    PlaceholderText="{markup:I18n Key=Project_SearchTemplate}"
                    FontSize="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    TextChanged="OnFilterChanged"/>

                <ListView x:Name="templateListView"
                    Grid.Row="1"
                    Margin="0 20 0 0"                    
                    ItemsSource="{x:Bind _viewModel.AvailableTemplates}"
                    ItemTemplate="{StaticResource AvailableItemTemplate}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                    KeyboardAcceleratorPlacementMode="Hidden"/>
            </Grid>

            <Grid x:Name="DetailsGrid"
                Margin="0 20 0 0"               
                Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <styles:ArcImage
                    Width="320"
                    Height="200"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    ResourceKey="{x:Bind _viewModel.SelectedTemplate.DescImageKey, Mode=OneWay, TargetNullValue='', FallbackValue=''}"/>

                <TextBlock
                    Grid.Row="1"
                    Margin="0 10"
                    TextWrapping="WrapWholeWords"
                    Text="{x:Bind _viewModel.SelectedTemplate.Desc, Mode=OneWay, Converter={StaticResource LocalizeConv}, TargetNullValue='', FallbackValue=''}"/>

                <StackPanel
                    Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    Spacing="10"
                    Margin="0 0 0 20">
                    <StackPanel
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        Spacing="6">
                        <TextBlock Text="{markup:I18n Key=Project_NewProjectName}" FontSize="12"/>

                        <TextBox x:Name="tbProjName"
                            IsSpellCheckEnabled="False"
                            Text="{x:Bind _viewModel.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{markup:I18n Key=Project_NewProjectName_Placeholder}"
                            FontSize="12"/>

                        <Grid MinHeight="18">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="2 0 0 0"
                                Visibility="{x:Bind _viewModel.IsNameOk, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                                <FontIcon 
                                    FontSize="14"
                                    Foreground="Red"
                                    Glyph="&#xE783;" />

                                <TextBlock
                                    Text="{markup:I18n Key=Project_NewName_InvalidTip}"
                                    FontSize="12"
                                    Foreground="Red"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        Spacing="6"
                        Visibility="{x:Bind _viewModel.IsWebTemplateSelected, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                        <TextBlock Text="{markup:I18n Key=Project_NewDraftPosition}" FontSize="12"/>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind _viewModel.ProjectLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="12"/>

                            <Button
                                Grid.Column="1"
                                Command="{x:Bind _viewModel.BrowseProjectLocationCommand}"
                                ToolTipService.ToolTip="{markup:I18n Key=Project_NewDraftPosition_BrowserFolder_Tooltip}">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;"/>
                            </Button>
                        </Grid>

                        <Grid MinHeight="18">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="2 0 0 0"
                                Visibility="{x:Bind _viewModel.IsLocationOk, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="Red"
                                    Glyph="&#xE783;"/>

                                <TextBlock
                                    Text="{markup:I18n Key=Project_NewPosition_InvalidTip}"
                                    FontSize="12"
                                    Foreground="Red"/>
                            </StackPanel>

                            <TextBlock
                                FontSize="12"
                                TextWrapping="WrapWholeWords"
                                Opacity="0.7"
                                Visibility="{x:Bind _viewModel.IsProjectCreatePathVisible, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                                <Run Text="{markup:I18n Key=Project_DeployNewDraft_Desc}"/>
                                <Run Text=" "/>
                                <Run Text="{x:Bind _viewModel.ProjectCreatePathText, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
