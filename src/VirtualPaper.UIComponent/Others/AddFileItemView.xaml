<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VirtualPaper.UIComponent.Others.AddFileItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.UIComponent.Others"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cvs="using:VirtualPaper.UIComponent.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cvs:VisibilityByValueConverter x:Key="VisibilityByValueConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel
            Orientation="Vertical"
            HorizontalAlignment="Left"
            Spacing="6">
            <TextBlock
                l:Uids.Uid="Ui_Text_Name_Text"
                FontWeight="Bold"
                FontSize="16"/>

            <TextBox AutomationProperties.AutomationId="Dialog.ItemName"
                IsSpellCheckEnabled="False"
                Text="{x:Bind _viewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                FontSize="16"
                Width="500">
            </TextBox>

            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                Margin="2 0 0 0"
                Visibility="{x:Bind _viewModel.IsNameOk, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                <FontIcon
                    FontSize="16"
                    VerticalAlignment="Bottom"
                    Foreground="#FFFF4D4D"
                    Glyph="&#xE783;" />

                <TextBlock
                    l:Uids.Uid="Ui_Project_NewName_InvalidTip_Text"
                    FontSize="14"
                    Foreground="#FFFF4D4D"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
