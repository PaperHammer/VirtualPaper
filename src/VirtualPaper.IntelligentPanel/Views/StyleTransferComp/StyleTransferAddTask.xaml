<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.IntelligentPanel.Views.StyleTransferComp.StyleTransferAddTask"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.IntelligentPanel.Views.StyleTransferComp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lcl_models="using:VirtualPaper.IntelligentPanel.Models"
    xmlns:uicomp_utils="using:VirtualPaper.UIComponent.Utils"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Grid x:Name="addTaskGrid"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectorColumn.Width" Value="Auto"/>
                        <Setter Target="OptionsColumn.Width" Value="*"/>
                        <Setter Target="ConnectorPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="ConnectorPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="ConnectorPanel.Margin" Value="20,-40,20,0"/>
                        <Setter Target="OptionsPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="OptionsPanel.(Grid.Column)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ConnectorColumn" Width="0"/>
            <ColumnDefinition x:Name="OptionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Stretch" MaxWidth="420" Spacing="6">

            <TextBlock 
                l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Text"
                MinHeight="36" TextWrapping="Wrap" TextAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="4 3"
                    Fill="Transparent"/>

                <Button x:Name="sourceImageBorder" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="Intelligent.StyleTransfer.Source"
                    l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Import_AutomationProperties_Name"
                    AutomationProperties.HelpText="{x:Bind _viewModel.SourceFilePath, Mode=OneWay}"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch"
                    Height="250"
                    Margin="10"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    uicomp_utils:CursorUtil.CursorShape="Hand"
                    Click="SourceImageButton_Click">
                    <Grid>
                        <StackPanel 
                            HorizontalAlignment="Stretch"
                            Margin="16"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}">
                            <FontIcon 
                                Glyph="&#xE8B9;"
                                FontSize="28"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Import_Text"
                                TextWrapping="Wrap" TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="14"/>
                        </StackPanel>

                        <Image x:Name="sourceImage"
                            Stretch="UniformToFill"
                            Source="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                    </Grid>
                </Button>
            </Grid>

            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind _viewModel.SourceFilePath, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE809;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileResolution, Mode=OneWay}" 
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileSize, Mode=OneWay}" 
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock 
                        Text="{x:Bind _viewModel.SourceFileExt, Mode=OneWay}" 
                        FontSize="14" 
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="ConnectorPanel"
            Grid.Row="1"
            VerticalAlignment="Center"
            Margin="0,16">
            <Border 
                Width="48"
                Height="48"
                CornerRadius="14"
                Background="{ThemeResource AccentButtonBackground}"
                BorderBrush="{ThemeResource AccentButtonBorderBrush}"
                BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon 
                    Glyph="&#xE710;"
                    FontSize="20"
                    Foreground="{ThemeResource AccentButtonForeground}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel x:Name="OptionsPanel"
            Grid.Row="2"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            MaxWidth="420"
            Spacing="6">

            <Grid HorizontalAlignment="Stretch" MinHeight="36" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    l:Uids.Uid="Ui_Intelligent_Task_Style_Text"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"/>

                <Button x:Name="styleGalleryButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Padding="8,4"
                    CornerRadius="6"
                    Background="Transparent"
                    uicomp_utils:CursorUtil.CursorShape="Hand"
                    BorderThickness="0">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71D;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock 
                            l:Uids.Uid="Ui_Intelligent_Style_Lib_Text"
                            Grid.Column="1" TextWrapping="Wrap"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>

                    <Button.Flyout>
                        <Flyout x:Name="styleGalleryFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MinWidth" Value="280"/>
                                    <Setter Property="MaxWidth" Value="620"/>
                                    <Setter Property="Padding" Value="16"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <StackPanel Spacing="12" MaxWidth="588">
                                <TextBlock 
                                    l:Uids.Uid="Ui_Intelligent_Style_Inner_Select_Text"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                                <GridView x:Name="styleGridView"
                                    ItemsSource="{x:Bind _viewModel.StyleOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind _viewModel.SelectedStyle, Mode=TwoWay}"                                        
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    MaxHeight="480"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollMode="Enabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid 
                                                Orientation="Horizontal" 
                                                MaximumRowsOrColumns="3"
                                                ItemWidth="184"
                                                ItemHeight="210"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="lcl_models:StyleOptionItem">
                                            <Grid Margin="4" Width="168" Height="196">
                                                <Border
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Grid>
                                                        <Image 
                                                            Stretch="UniformToFill"
                                                            Source="{x:Bind ThumbnailResourceKey, Mode=OneWay, Converter={StaticResource ResourceKeyToImageConverter}}"/>

                                                        <StackPanel 
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="6"
                                                            Visibility="{x:Bind IsCustom}">
                                                            <FontIcon 
                                                                Glyph="&#xE710;"
                                                                FontSize="24"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock 
                                                                l:Uids.Uid="Ui_Intelligent_Style_Type_Custom_Text"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,4"
                                                    CornerRadius="0,0,8,8"
                                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                                                    <TextBlock 
                                                        Text="{x:Bind Name, Mode=OneWay}"
                                                        FontSize="12"
                                                        TextWrapping="Wrap" TextAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="4 3"
                    Fill="Transparent"/>

                <Button x:Name="styleImageBorder" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="Intelligent.StyleTransfer.Style"
                    l:Uids.Uid="Ui_Intelligent_Task_Style_Img_Import_AutomationProperties_Name"
                    AutomationProperties.HelpText="{x:Bind _viewModel.SelectedStyle.ImagePath, Mode=OneWay}"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch"
                    Height="250"
                    Margin="10"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    uicomp_utils:CursorUtil.CursorShape="Hand"
                    Click="StyleImageButton_Click">
                    <Grid>
                        <StackPanel 
                            HorizontalAlignment="Stretch"
                            Margin="16"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind _viewModel.SelectedStyle.ImagePath, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}">
                            <FontIcon 
                                Glyph="&#xE8B3;"
                                FontSize="28"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock 
                                l:Uids.Uid="Ui_Intelligent_Task_Style_Img_Import_Text"
                                TextWrapping="Wrap" TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="14"/>
                        </StackPanel>

                        <Image x:Name="styleImage"
                            Stretch="UniformToFill"
                            Source="{x:Bind _viewModel.SelectedStyle.ImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                    </Grid>
                </Button>
            </Grid>

            <StackPanel HorizontalAlignment="Center">
                <StackPanel 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <TextBlock x:Name="styleName"
                                Text="{x:Bind _viewModel.SelectedStyle.Name, Mode=OneWay}"
                                Visibility="{x:Bind _viewModel.SelectedStyle.Name, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"
                                FontSize="14"
                                MaxWidth="120"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="styleNameFallback"
                                l:Uids.Uid="Ui_Intelligent_Task_Style_Img_Import_Text"
                                Visibility="{x:Bind _viewModel.SelectedStyle.Name, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}"
                                FontSize="14"
                                MaxWidth="120"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                        Visibility="{x:Bind _viewModel.SelectedStyle.FileSize, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}">
                        <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock 
                            Text="{x:Bind _viewModel.SelectedStyle.FileSize, Mode=OneWay}" 
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                        Visibility="{x:Bind _viewModel.SelectedStyle.FileExt, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock 
                            Text="{x:Bind _viewModel.SelectedStyle.FileExt, Mode=OneWay}" 
                            FontSize="14" 
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Padding="10,8" ColumnSpacing="8" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon 
                    Glyph="&#xE946;"
                    FontSize="13"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"/>
                    <TextBlock 
                    l:Uids.Uid="Ui_Intelligent_Style_Img_Desc_Text"
                    Grid.Column="1"
                    FontSize="12"
                    TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</arc:ArcPage>
