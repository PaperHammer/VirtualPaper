<?xml version="1.0" encoding="utf-8"?>
<arc:ArcUserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Components.WebEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Components"
    xmlns:bottomPanels="using:Workloads.Creation.WebBackdrop.Views.Components.BottomPanels"
    xmlns:tools="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:models="using:Workloads.Creation.WebBackdrop.Models"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    xmlns:utils="using:VirtualPaper.UIComponent.Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"  
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="ArcUserControl_Loaded">

    <arc:ArcUserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="J" Invoked="KeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="KeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control,Menu" Key="B" Invoked="KeyboardAccelerator_Invoked"/>
    </arc:ArcUserControl.KeyboardAccelerators>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="leftSideBarColumn" Width="260"/>
                <ColumnDefinition/>
                <ColumnDefinition x:Name="rightSideBarColumn" Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid x:Name="leftSideBar" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <tools:WebFileTreeControl x:Name="leftFileTreeControl"
                        SelectedFileItem="{x:Bind ViewModel.SelectedFileItem, Mode=TwoWay}"
                        FileOpenRequested="FileTree_FileOpenRequested"
                        FolderSelected="FileTree_FolderSelected"/>

                    <Rectangle x:Name="leftSideBarBorderLine"
                        Width="1"
                        HorizontalAlignment="Right"
                        Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                </Grid>

                <Grid x:Name="leftSideBarSplitter"
                    Width="7"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    ManipulationDelta="LeftSideBarSplitter_ManipulationDelta"
                    PointerEntered="Splitter_PointerEntered"
                    PointerExited="Splitter_PointerExited"
                    utils:CursorUtil.CursorShape="SizeWestEast">

                    <Rectangle x:Name="leftSideBarSplitterLine"
                        Width="4"
                        HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0 0 0 1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TabView x:Name="fileTabView"
                            TabWidthMode="SizeToContent"
                            CloseButtonOverlayMode="OnPointerOver"
                            TabItemsSource="{x:Bind ViewModel.OpenFiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.ActiveFile, Mode=TwoWay}"
                            TabCloseRequested="FileTabView_TabCloseRequested"
                            SelectionChanged="FileTabView_SelectionChanged">
                            <TabView.TabItemTemplate>
                                <DataTemplate x:DataType="models:WebEditorFile">
                                    <TabViewItem>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                            <TextBlock Text="{x:Bind FileName}" FontSize="12"/>
                                            <Ellipse
                                                Width="6" Height="6"
                                                Fill="{ThemeResource SystemAccentColor}"
                                                Visibility="{x:Bind IsSaved, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}"/>
                                        </StackPanel>
                                    </TabViewItem>
                                </DataTemplate>
                            </TabView.TabItemTemplate>
                        </TabView>

                        <local:MonacoEditor x:Name="monacoEditor"
                            Grid.Row="1"
                            EditorContent="{x:Bind ViewModel.ActiveFile.Content, Mode=TwoWay}"
                            EditorLanguage="{x:Bind ActiveFileLanguage, Mode=OneWay}"
                            ContentChanged="MonacoEditor_ContentChanged"
                            CursorPositionChanged="MonacoEditor_CursorPositionChanged"
                            MarkersChanged="MonacoEditor_MarkersChanged"
                            ShortcutRequested="MonacoEditor_ShortcutRequested"/>

                        <Grid
                            x:Name="welcomePanel"
                            Grid.Row="1"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                                <FontIcon
                                    Glyph="&#xE8A5;"
                                    FontSize="42"
                                    Opacity="0.45"/>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Select a file to start"/>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Opacity="0.6"
                                    Text="Open a file from the explorer to edit and preview."/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="bottomPanel"
                    Grid.Row="1"
                    Height="240"
                    MinHeight="40"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0 1 0 0"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <SelectorBar x:Name="bottomPanelSelectorBar"
                            SelectionChanged="BottomPanelSelectorBar_SelectionChanged">
                            <SelectorBarItem Text="PROBLEMS" Tag="PROBLEMS" IsSelected="True"/>
                            <SelectorBarItem Text="OUTPUT" Tag="OUTPUT"/>
                        </SelectorBar>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Padding="8 0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Click="BottomPanelClose_Click">
                            <FontIcon Glyph="&#xE921;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <bottomPanels:WebProblemsPanelControl x:Name="problemsPanel"
                            Visibility="Collapsed"
                            ProblemRequested="ProblemsPanel_ProblemRequested"/>
                        <TextBlock x:Name="bottomPanelContent"
                            Margin="12"
                            FontSize="12"
                            Opacity="0.7"/>
                    </Grid>
                    <Rectangle x:Name="bottomSideBarBorderLine"
                        Height="1"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <Grid x:Name="bottomSideBarSplitter"
                        Height="7"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Visibility="Collapsed"
                        ManipulationMode="TranslateY"
                        ManipulationDelta="BottomSideBarSplitter_ManipulationDelta"
                        PointerEntered="Splitter_PointerEntered"
                        PointerExited="Splitter_PointerExited"
                        utils:CursorUtil.CursorShape="SizeNorthSouth">

                        <Rectangle x:Name="bottomSideBarSplitterLine"
                            Height="4"
                            VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="rightSideBar"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <tools:WebPropertyPanelControl x:Name="propertyPanelControl"/>

                <Rectangle x:Name="rightSideBarBorderLine"
                    Width="1"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                <Grid x:Name="rightSideBarSplitter"
                    Width="7"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    ManipulationDelta="RightSideBarSplitter_ManipulationDelta"
                    PointerEntered="Splitter_PointerEntered"
                    PointerExited="Splitter_PointerExited"
                    utils:CursorUtil.CursorShape="SizeWestEast">

                    <Rectangle x:Name="rightSideBarSplitterLine"
                        Width="4"
                        HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <tools:WebStatusBarControl x:Name="statusBar"                
                ActiveFileLanguage="{x:Bind ActiveFileLanguage, Mode=OneWay}"
                LineNumber="{x:Bind CursorLineNumber, Mode=OneWay}"
                Column="{x:Bind CursorColumn, Mode=OneWay}"
                SelectedCharacterCount="{x:Bind SelectedCharacterCount, Mode=OneWay}"
                IsSelectedCharacterCountOverflow="{x:Bind IsSelectedCharacterCountOverflow, Mode=OneWay}"
                ProblemErrorCount="{x:Bind ProblemErrorCount, Mode=OneWay}"
                ProblemWarningCount="{x:Bind ProblemWarningCount, Mode=OneWay}"
                PanelRequested="StatusBar_PanelRequested"
                RunRequested="StatusBar_RunRequested"
                DebugRequested="StatusBar_DebugRequested"
                ToggleLeftSideBarRequested="StatusBar_ToggleLeftSideBarRequested"
                ToggleBottomPanelRequested="StatusBar_ToggleBottomPanelRequested"
                ToggleRightSideBarRequested="StatusBar_ToggleRightSideBarRequested"/>

            <Rectangle x:Name="bottomStatusSideBarBorderLine"
                Height="1"
                VerticalAlignment="Top"
                Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Grid>
    </Grid>
</arc:ArcUserControl>
