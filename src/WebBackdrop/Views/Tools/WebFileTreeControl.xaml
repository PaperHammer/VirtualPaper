<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebFileTreeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:models="using:Workloads.Creation.WebBackdrop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:collection="using:VirtualPaper.UIComponent.Collection"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:markup="using:VirtualPaper.UIComponent.ArcMarkupExtension"
    xmlns:input="using:VirtualPaper.UIComponent.Input"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Thickness x:Key="ScrollViewerScrollBarMargin">1 1 8 1</Thickness>
        <Style
            x:Key="WebBackdropSearchTextBoxStyle"
            TargetType="TextBox"
            BasedOn="{StaticResource ArcCompactTextBoxDefaultStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8 4 66 3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        </Style>
        <Style
            x:Key="WebBackdropRenameTextBoxStyle"
            TargetType="input:ArcTextBox"
            BasedOn="{StaticResource ArcTextBoxDefaultStyle}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="3 2 3 0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        </Style>
        <DataTemplate x:Key="FolderTemplate" x:DataType="models:WebFileItem">
            <collection:ArcTreeViewItem AutomationProperties.Name="{x:Bind FileName}"
                HorizontalContentAlignment="Stretch"
                Opacity="{x:Bind CutOpacity, Mode=OneWay}"
                IsContextMenuTarget="{x:Bind IsContextMenuTarget, Mode=OneWay}"
                ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                <collection:ArcTreeViewItem.ContextFlyout>
                    <MenuFlyout Opening="FolderMenuFlyout_Opening" Closed="ContextMenuFlyout_Closed">
                        <MenuFlyoutItem x:Name="folderNewFileMenuItem" Text="New File" Tag="{x:Bind}" Click="NewFileMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderNewFolderMenuItem" Text="New Folder" Tag="{x:Bind}" Click="NewFolderMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderAddItemsMenuItem" Text="Add Items" Tag="{x:Bind}" Click="AddItemsMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="folderEditSeparator1"/>
                        <MenuFlyoutItem x:Name="folderCutMenuItem" Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" Tag="{x:Bind}" Click="CutMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderCopyMenuItem" Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Tag="{x:Bind}" Click="CopyMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="pasteMenuItem" Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" Tag="{x:Bind}" Click="PasteMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderCopyPathMenuItem" Text="Copy Path" KeyboardAcceleratorTextOverride="Shift+Alt+C" Tag="{x:Bind}" Click="CopyPathMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderCopyRelativePathMenuItem" Text="Copy Relative Path" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" Tag="{x:Bind}" Click="CopyRelativePathMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="folderEditSeparator2"/>
                        <MenuFlyoutItem x:Name="folderRenameMenuItem" Text="Rename..." KeyboardAcceleratorTextOverride="F2" Tag="{x:Bind}" Click="RenameMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="folderDeleteMenuItem" Text="Delete" KeyboardAcceleratorTextOverride="Del" Tag="{x:Bind}" Click="DeleteMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="folderExplorerSeparator"/>
                        <MenuFlyoutItem x:Name="folderRevealMenuItem" Text="Reveal in Explorer" Tag="{x:Bind}" Click="RevealInExplorerMenuItem_Click"/>
                    </MenuFlyout>
                </collection:ArcTreeViewItem.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path
                        Width="18"
                        Height="18"
                        Data="{x:Bind FolderIconDataResourceKey, Mode=OneWay, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                        Fill="{StaticResource WebBackdrop_FileTree_Folder_Brush}"
                        Stretch="Uniform"
                        UseLayoutRounding="True"/>
                        <StackPanel>
                            <Grid>
                            <TextBlock 
                                Text="{x:Bind FileName}" 
                                LineHeight="22"
                                TextWrapping="NoWrap" 
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind IsRenaming, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                                <interactivity:Interaction.Behaviors>
                                    <!-- 当文件不存在时，使用固定的红色笔刷 -->
                                    <interactivity:DataTriggerBehavior Binding="{x:Bind ExistsOnDisk, Mode=OneWay}" Value="False">
                                        <interactivity:ChangePropertyAction PropertyName="Foreground" Value="{x:Bind MissingBrush}" />
                                    </interactivity:DataTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </TextBlock>
                            <input:ArcTextBox
                                Style="{StaticResource WebBackdropRenameTextBoxStyle}"
                                Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind IsRenaming, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"
                                Tag="{x:Bind}"
                                TextChanged="RenameTextBox_TextChanged"
                                KeyDown="RenameTextBox_KeyDown"
                                LostFocus="RenameTextBox_LostFocus"/>
                            <Border
                                BorderThickness="1"
                                BorderBrush="#FFFF4D4D"
                                CornerRadius="2"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind IsRenameInvalid, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"/>
                            <Rectangle 
                                Height="1"
                                Margin="0 4 0 0"
                                Fill="{x:Bind MissingBrush}"
                                Visibility="{x:Bind ExistsOnDisk, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}" />
                            </Grid>
                            <Popup
                            IsOpen="{x:Bind IsRenameInvalid, Mode=OneWay}"
                            IsLightDismissEnabled="False"
                            HorizontalOffset="0"
                            VerticalOffset="0">
                            <Border
                                MaxWidth="360"
                                Padding="6 3"
                                BorderThickness="1"
                                BorderBrush="#FFFF4D4D"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                CornerRadius="4"
                                IsHitTestVisible="False">
                                <TextBlock
                                    Text="{markup:I18n Key=Project_NewName_InvalidTip}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="#FFFF4D4D"/>
                            </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="models:WebFileItem">
            <collection:ArcTreeViewItem AutomationProperties.Name="{x:Bind FileName}" HorizontalContentAlignment="Stretch"
                ExpandCollapseGlyphVisibility="Collapsed"
                Opacity="{x:Bind CutOpacity, Mode=OneWay}"
                ItemsSource="{x:Bind Children}"
                IsSelected="{x:Bind IsActiveFile, Mode=OneWay}"
                IsContextMenuTarget="{x:Bind IsContextMenuTarget, Mode=OneWay}"
                Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                <collection:ArcTreeViewItem.ContextFlyout>
                    <MenuFlyout Opening="FileMenuFlyout_Opening" Closed="ContextMenuFlyout_Closed">
                        <MenuFlyoutItem x:Name="fileSaveMenuItem" Text="Save" Tag="{x:Bind}" Click="SaveMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="fileSaveAsMenuItem" Text="Save As..." Tag="{x:Bind}" Click="SaveAsMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="fileSaveSeparator"/>
                        <MenuFlyoutItem x:Name="fileCutMenuItem" Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" Tag="{x:Bind}" Click="CutMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="fileCopyMenuItem" Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Tag="{x:Bind}" Click="CopyMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="fileCopyPathMenuItem" Text="Copy Path" KeyboardAcceleratorTextOverride="Shift+Alt+C" Tag="{x:Bind}" Click="CopyPathMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="fileCopyRelativePathMenuItem" Text="Copy Relative Path" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" Tag="{x:Bind}" Click="CopyRelativePathMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="fileEditSeparator"/>
                        <MenuFlyoutItem x:Name="fileRenameMenuItem" Text="Rename..." KeyboardAcceleratorTextOverride="F2" Tag="{x:Bind}" Click="RenameMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="fileDeleteMenuItem" Text="Delete" KeyboardAcceleratorTextOverride="Del" Tag="{x:Bind}" Click="DeleteMenuItem_Click"/>
                        <MenuFlyoutSeparator x:Name="fileExplorerSeparator"/>
                        <MenuFlyoutItem x:Name="fileRevealMenuItem" Text="Reveal in Explorer" Tag="{x:Bind}" Click="RevealInExplorerMenuItem_Click"/>
                    </MenuFlyout>
                </collection:ArcTreeViewItem.ContextFlyout>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path
                            Width="18"
                            Height="18"
                            Data="{x:Bind IconDataResourceKey, Mode=OneWay, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                            Fill="{x:Bind IconBrush, Mode=OneWay}"
                            Stretch="Uniform"
                            UseLayoutRounding="True"/>
                        <StackPanel>
                            <Grid>
                                <TextBlock 
                                    Text="{x:Bind FileName}" 
                                    LineHeight="22"
                                    TextWrapping="NoWrap" 
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind IsRenaming, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                                    <interactivity:Interaction.Behaviors>
                                        <!-- 当文件不存在时，使用固定的红色笔刷 -->
                                        <interactivity:DataTriggerBehavior Binding="{x:Bind ExistsOnDisk, Mode=OneWay}" Value="False">
                                            <interactivity:ChangePropertyAction PropertyName="Foreground" Value="{x:Bind MissingBrush}" />
                                        </interactivity:DataTriggerBehavior>
                                    </interactivity:Interaction.Behaviors>
                                </TextBlock>
                                <input:ArcTextBox
                                    Style="{StaticResource WebBackdropRenameTextBoxStyle}"
                                    Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{x:Bind IsRenaming, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"
                                    Tag="{x:Bind}"
                                    TextChanged="RenameTextBox_TextChanged"
                                    KeyDown="RenameTextBox_KeyDown"
                                    LostFocus="RenameTextBox_LostFocus"/>
                                <Border
                                    BorderThickness="1"
                                    BorderBrush="#FFFF4D4D"
                                    CornerRadius="2"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsRenameInvalid, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"/>
                                <Rectangle 
                                    Height="1"
                                    Margin="0 4 0 0"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind MissingBrush}"
                                    Visibility="{x:Bind ExistsOnDisk, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}" />
                            </Grid>
                            <Popup
                                IsOpen="{x:Bind IsRenameInvalid, Mode=OneWay}"
                                IsLightDismissEnabled="False"
                                HorizontalOffset="0"
                                VerticalOffset="0">
                                <Border
                                    MaxWidth="360"
                                    Padding="6 3"
                                    BorderThickness="1"
                                    BorderBrush="#FFFF4D4D"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    CornerRadius="4"
                                    IsHitTestVisible="False">
                                    <TextBlock
                                        Text="{markup:I18n Key=Project_NewName_InvalidTip}"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="#FFFF4D4D"/>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Margin="10 0"
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="2"
                        Visibility="{x:Bind IsSaved, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                        <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemAccentColor}"/>
                    </Border>
                </Grid>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <local:WebFileItemTemplateSelector
            x:Key="WebFileItemTemplateSelector"
            FolderTemplate="{StaticResource FolderTemplate}"
            FileTemplate="{StaticResource FileTemplate}"/>

        <DataTemplate x:Key="ContentSearchFileTemplate" x:DataType="models:WebContentSearchFileResult">
            <Expander
                IsExpanded="True"
                Margin="2 1"
                Padding="10 6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center">
                <Expander.Header>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind RelativePath}" Opacity="0.5" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind MatchCount}" Opacity="0.65"/>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <ItemsControl
                        ItemsSource="{x:Bind Matches}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WebContentSearchMatch">
                                <Button
                                    Tag="{x:Bind}"
                                    Click="ContentSearchMatch_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="0 4 6 4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind LineLabel}" Opacity="0.55" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PreviewText}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Stretch" HorizontalTextAlignment="Start" VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander.Content>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="leftPanelRoot"
        PointerEntered="LeftPanel_PointerEntered"
        PointerExited="LeftPanel_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Margin="8 6 8 4">
            <TextBox x:Name="contentSearchBox"
                Style="{StaticResource WebBackdropSearchTextBoxStyle}"
                AutomationProperties.Name="Search in files"
                PlaceholderText="Search in files"
                KeyDown="ContentSearchBox_KeyDown"
                Text="{x:Bind _viewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel
                Orientation="Horizontal"
                Spacing="2"
                Margin="0 0 4 0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <ToggleButton
                    Width="28"
                    Height="24"
                    Padding="0"
                    Content="Aa"
                    FontSize="11"
                    BorderThickness="0"
                    Background="Transparent"
                    IsChecked="{x:Bind _viewModel.IsCaseSensitive, Mode=TwoWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Match Case"/>
                    </ToolTipService.ToolTip>
                </ToggleButton>
                <ToggleButton
                    Width="28"
                    Height="24"
                    Padding="0"
                    Content="ab"
                    FontSize="11"
                    BorderThickness="0"
                    Background="Transparent"
                    IsChecked="{x:Bind _viewModel.IsWholeWord, Mode=TwoWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Match Whole Word"/>
                    </ToolTipService.ToolTip>
                </ToggleButton>
            </StackPanel>
        </Grid>
        
        <ProgressBar
            Grid.Row="1"
            Height="2"
            Margin="8 0"
            IsIndeterminate="True"
            IsHitTestVisible="False"
            Visibility="{x:Bind _viewModel.IsSearching, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"/>
        
        <collection:ArcTreeView x:Name="fileTreeView"
            Grid.Row="2"
            Padding="4 0 0 48"
            CancelSelectionEnable="False"
            AllowDrop="True"
            DragItemsStarting="FileTreeView_DragItemsStarting"
            DragItemsCompleted="FileTreeView_DragItemsCompleted"
            SelectedItem="{x:Bind SelectedFileItem, Mode=TwoWay}"
            SelectionChanged="FileTreeView_SelectionChanged"
            ItemsSource="{x:Bind _viewModel.FileItems}"
            ItemTemplateSelector="{StaticResource WebFileItemTemplateSelector}"
            ItemInvoked="FileTreeView_ItemInvoked"
            Visibility="{x:Bind _viewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
        </collection:ArcTreeView>
        
        <Border x:Name="stickyFoldersPanel"
            Grid.Row="2"
            Canvas.ZIndex="2"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0 0 0 1">
            <ItemsControl
                ItemsSource="{x:Bind _stickyFolders}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WebFileItem">
                        <Button
                            Tag="{x:Bind}"
                            Click="StickyFolder_Click"
                            Height="24"
                            Padding="8 0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Padding="6 0" Width="28">
                                    <TextBlock
                                        Width="16"
                                        Height="16"
                                        Padding="1"
                                        Text="&#xE70D;"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TreeViewItemForeground}"
                                        VerticalAlignment="Center"
                                        IsTextScaleFactorEnabled="False"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                                <Path
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    Data="{x:Bind FolderIconDataResourceKey, Mode=OneWay, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                    Fill="{StaticResource WebBackdrop_FileTree_Folder_Brush}"
                                    Stretch="Uniform"/>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind FileName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        
        <ListView x:Name="contentSearchResultsList"
            Grid.Row="2"
            Padding="0 0 0 48"
            ItemsSource="{x:Bind _viewModel.SearchResults}"
            ItemTemplate="{StaticResource ContentSearchFileTemplate}"
            SelectionMode="None"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind _viewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"/>
    </Grid>
</UserControl>
