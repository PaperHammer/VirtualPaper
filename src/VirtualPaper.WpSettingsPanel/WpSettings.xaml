<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.WpSettingsPanel.WpSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.WpSettingsPanel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    xmlns:models="using:VirtualPaper.Models.Cores"
    xmlns:localViewModel="using:VirtualPaper.WpSettingsPanel.ViewModels"
    xmlns:localUtils="using:VirtualPaper.WpSettingsPanel.Utils"
    xmlns:input="using:VirtualPaper.UIComponent.Input"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <arc:ArcPage.Resources>
        <Style x:Key="LibraryDropDownStyle" TargetType="DropDownButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <SolidColorBrush x:Key="LibraryImportBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.08"/>
        <SolidColorBrush x:Key="LibraryImportBorder" Color="{ThemeResource SystemAccentColor}" Opacity="0.32"/>
        <Style x:Key="LibraryImportButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LibraryImportBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryImportBorder}"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>
        <SolidColorBrush x:Key="LibraryFilterSelectedBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.10"/>
        <SolidColorBrush x:Key="LibraryFilterSelectedPointerOverBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.14"/>
        <SolidColorBrush x:Key="LibraryFilterSelectedPressedBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.18"/>
        <Style x:Key="LibraryFilterItemStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8 0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ItemBackground" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <!-- ToggleButton combines check and pointer states. -->
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{StaticResource LibraryFilterSelectedBackground}"/>
                                            <Setter Target="ItemContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Target="ItemContent.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{StaticResource LibraryFilterSelectedPointerOverBackground}"/>
                                            <Setter Target="ItemContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Target="ItemContent.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{StaticResource LibraryFilterSelectedPressedBackground}"/>
                                            <Setter Target="ItemContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <Setter Target="ItemContent.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{StaticResource LibraryFilterSelectedBackground}"/>
                                            <Setter Target="ItemContent.FontWeight" Value="SemiBold"/>
                                            <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ItemContent" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <FontIcon x:Name="SelectedCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibilityByValueConverter}}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </arc:ArcPage.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLibraryToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FilterBar.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="LibraryActionButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="LibraryActionButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="LibraryActionButtons.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="LibraryActionButtons.Margin" Value="0 8 0 0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLibraryToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1040"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <arc:ArcPageHost x:Name="MainHost">
        <NavigationView x:Name="NvLocal" 
            Padding="10 0"
            PaneDisplayMode="Top"
            SelectionFollowsFocus="Enabled" 
            IsBackButtonVisible="Collapsed" 
            IsSettingsVisible="False"
            SelectionChanged="NvLocal_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="Nav_LibraryContents"
                    l:Uids.Uid="Ui_WpSettings_NavTitle_LibraryContents_Content"
                    IsSelected="True"/>
                <NavigationViewItem x:Name="Nav_ScreenSaver"
                    AutomationProperties.AutomationId="Library.Tab.ScreenSaver"
                    l:Uids.Uid="Ui_WpSettings_NavTitle_ScrSettings_Content"/>
            </NavigationView.MenuItems>

            <Grid Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="LibraryToolbar" Margin="12 4 12 8" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="FilterBar">
                        <Grid x:Name="LibraryBrowseTools" ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" MaxWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="tbSearchName"
                                AutomationProperties.AutomationId="Library.Search"
                                Style="{StaticResource ArcSearchBoxStyle}"
                                Tag="{x:Bind localUtils:FilterKey.LibraryTitle}"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                QueryIcon="Find"
                                l:Uids.Uid="Ui_WpLib_Search_Placeholder_PlaceholderText"
                                VerticalAlignment="Center"
                                TextChanged="OnFilterChanged"/>

                            <DropDownButton x:Name="LibraryTypeFilter"
                                AutomationProperties.AutomationId="Library.Filters"
                                Grid.Column="1" Style="{StaticResource LibraryDropDownStyle}"
                                Width="140">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                                    <TextBlock
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind _viewModel.TypeFilterLabel, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                      <StackPanel Spacing="8" Width="260">
                                        <StackPanel Spacing="4">
                                            <TextBlock Margin="8 0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                l:Uids.Uid="Ui_WpLib_TypeFilterLabel"/>
                                            <ItemsControl ItemsSource="{x:Bind _viewModel.TypeFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="localUtils:WpTypeFilterItem">
                                                        <ToggleButton Style="{StaticResource LibraryFilterItemStyle}"
                                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                            ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis"/>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border Height="1" Margin="8 0" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                        <ToggleButton Style="{StaticResource LibraryFilterItemStyle}"
                                            IsChecked="{x:Bind _viewModel.FavoritesOnly, Mode=TwoWay}"
                                            AutomationProperties.AutomationId="Library.FavoritesOnly"
                                            l:Uids.Uid="Ui_WpLib_Favorites"/>
                                        <StackPanel Spacing="6" Margin="8 0">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                l:Uids.Uid="Ui_WpLib_TagFilterLabel"/>
                                            <AutoSuggestBox Style="{StaticResource ArcSearchBoxStyle}"
                                                ItemsSource="{x:Bind _viewModel.TagSuggestions, Mode=OneWay}"
                                                Text="{x:Bind _viewModel.TagKeyword, Mode=OneWay}"
                                                TextChanged="TagFilter_TextChanged" SuggestionChosen="TagFilter_SuggestionChosen"
                                                AutomationProperties.AutomationId="Library.TagFilter"
                                                HorizontalAlignment="Stretch" MinWidth="220"
                                                l:Uids.Uid="Ui_WpLib_TagFilter"/>
                                        </StackPanel>
                                        <HyperlinkButton HorizontalAlignment="Left" Padding="8 0" MinHeight="28"
                                            Click="ClearLibraryFilters_Click"
                                            l:Uids.Uid="Ui_WpLib_ClearFilters"/>
                                      </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton Grid.Column="2" MinWidth="110" Style="{StaticResource LibraryDropDownStyle}"
                                AutomationProperties.AutomationId="Library.Sort" l:Uids.Uid="Ui_WpLib_Sort">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="14"/>
                                    <TextBlock FontSize="14" VerticalAlignment="Center" l:Uids.Uid="Ui_WpLib_SortLabel"/>
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Opening="SortFlyout_Opening">
                                        <RadioMenuFlyoutItem GroupName="LibrarySort" Tag="Newest" IsChecked="True" Click="SortLibrary_Click" l:Uids.Uid="Ui_WpLib_SortNewest"/>
                                        <RadioMenuFlyoutItem GroupName="LibrarySort" Tag="Oldest" Click="SortLibrary_Click" l:Uids.Uid="Ui_WpLib_SortOldest"/>
                                        <RadioMenuFlyoutItem GroupName="LibrarySort" Tag="Title" Click="SortLibrary_Click" l:Uids.Uid="Ui_WpLib_SortTitle"/>
                                        <RadioMenuFlyoutItem GroupName="LibrarySort" Tag="Author" Click="SortLibrary_Click" l:Uids.Uid="Ui_WpLib_SortAuthor"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                        </Grid>

                        <StackPanel x:Name="LibrarySelectionTools"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock x:Name="LibrarySelectionCount"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button
                                Height="36"
                                Padding="10 0"
                                Click="SelectAllLibraryItems_Click"
                                l:Uids.Uid="Ui_WpLib_SelectAll_Content"/>
                            <Button
                                Height="36"
                                Padding="10 0"
                                Click="InvertLibrarySelection_Click"
                                l:Uids.Uid="Ui_WpLib_InvertSelection_Content"/>
                            <Button x:Name="DeleteSelectedLibraryItems"
                                Height="36"
                                Padding="10 0"
                                IsEnabled="False"
                                Click="DeleteSelectedLibraryItems_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock l:Uids.Uid="Ui_Text_Delete_Text"/>
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="OrganizeSelectedLibraryItems" Style="{StaticResource LibraryDropDownStyle}"
                                IsEnabled="False" l:Uids.Uid="Ui_WpLib_Organize">
                                <TextBlock l:Uids.Uid="Ui_WpLib_OrganizeLabel"/>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Opening="OrganizationMenu_Opening">
                                        <MenuFlyoutItem Tag="AddFavorite" Click="OrganizeSelectedLibraryItems_Click" l:Uids.Uid="Ui_WpLib_AddFavorite"/>
                                        <MenuFlyoutItem Tag="RemoveFavorite" Click="OrganizeSelectedLibraryItems_Click" l:Uids.Uid="Ui_WpLib_RemoveFavorite"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Tag="EditTags" Click="OrganizeSelectedLibraryItems_Click" l:Uids.Uid="Ui_WpLib_EditTags"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button
                                Height="36"
                                Padding="10 0"
                                AutomationProperties.AutomationId="Library.Selection.Done"
                                Click="CancelLibrarySelection_Click"
                                l:Uids.Uid="Ui_WpLib_FinishSelection"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="LibraryActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AddToLib" Style="{StaticResource LibraryImportButtonStyle}"
                            AutomationProperties.AutomationId="Library.Import"
                            l:Uids.Uid="Ui_WpLib_AddWallpaper_ToolTipService_ToolTip__WpLib_AddWallpaper_AutomationProperties_Name"
                            Command="{x:Bind _viewModel.AddToLibCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock l:Uids.Uid="Ui_WpLib_AddWallpaperLabel"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ControlCenter" Style="{StaticResource ToolbarActionButtonStyle}"
                            AutomationProperties.AutomationId="Library.DisplayControls"
                            l:Uids.Uid="Ui_WpLib_DisplayControls_ToolTipService_ToolTip__WpLib_DisplayControls_AutomationProperties_Name">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ToolbarIconStyle}"
                                            Stroke="{Binding Foreground, ElementName=ControlCenter}"
                                            Data="M4,4 L20,4 Q21,4 21,5 L21,15 Q21,16 20,16 L4,16 Q3,16 3,15 L3,5 Q3,4 4,4 Z M12,16 L12,20 M8,20 L16,20"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock l:Uids.Uid="Ui_WpLib_DisplayControlsLabel"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Opening="Flyout_Opening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MinWidth" Value="500"></Setter>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel
                                        Spacing="8"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal"  Spacing="8">
                                            <input:ArcButton x:Name="BtnClose"
                                                AutomationProperties.AutomationId="Library.CloseWallpaper"
                                                Height="33"
                                                MinWidth="66"
                                                l:Uids.Uid="Ui_Text_Close_Content"
                                                Background="PaleVioletRed"
                                                Command="{x:Bind _viewModel.WpCloseCommand}"/>
                                            <Button x:Name="BtnDetect"
                                                Height="33"
                                                MinWidth="66"
                                                l:Uids.Uid="Ui_Text_Detect_Content"
                                                Command="{x:Bind _viewModel.WpDetectCommand}"/>
                                            <Button x:Name="BtnIdentify"
                                                Height="33"
                                                MinWidth="66"
                                                l:Uids.Uid="Ui_Text_Identify_Content"
                                                Command="{x:Bind _viewModel.WpIdentifyCommand}"/>
                                            <Button x:Name="BtnAdjust"
                                                AutomationProperties.AutomationId="Library.AdjustWallpaper"
                                                Height="33"
                                                MinWidth="66"
                                                l:Uids.Uid="Ui_Text_Adjust_Content"
                                                Command="{x:Bind _viewModel.WpAdjustCommand}"/>
                                        </StackPanel>

                                        <GridView
                                            HorizontalAlignment="Center"
                                            ItemsSource="{x:Bind _viewModel.Monitors}"
                                            SelectedIndex="{x:Bind _viewModel.SelectedMonitorIndex, Mode=TwoWay}">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Monitor">
                                                    <Grid Width="184" Height="120">
                                                        <Image
                                                            Source="{x:Bind ThumbnailPath, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                        <Canvas>
                                                            <Canvas.Background>
                                                                <LinearGradientBrush StartPoint="0,0.4" EndPoint="0,1">
                                                                    <GradientStop Color="Transparent" Offset="0.0"/>
                                                                    <GradientStop Color="#0067c0" Offset="1.2"/>
                                                                </LinearGradientBrush>
                                                            </Canvas.Background>
                                                        </Canvas>
                                                        <Viewbox Width="120" Height="60">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Text="{x:Bind Content}" />
                                                        </Viewbox>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                        </GridView>

                                        <StackPanel x:Name="WallpaperArrangement"
                                            Orientation="Vertical"
                                            Spacing="4">

                                            <TextBlock x:Name="WpArrangHeader"
                                                l:Uids.Uid="Ui_Text_WpArrange_Text"
                                                FontWeight="Bold"/>

                                            <Grid BorderThickness="1" CornerRadius="5">
                                                <ListBox
                                                    Width="auto"
                                                    ItemsSource="{x:Bind _viewModel.WpArrangements}"
                                                    SelectedIndex="{x:Bind _viewModel.SelectedWpArrangementsIndex, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="localViewModel:WpArrangeDataModel">
                                                            <Grid ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                                <TextBlock Text="{x:Bind Method}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                </ListBox>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource ToolbarActionButtonStyle}"
                            AutomationProperties.AutomationId="Library.More" l:Uids.Uid="Ui_EffectPreset_More">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock l:Uids.Uid="Ui_WpLib_MoreLabel"/>
                                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem AutomationProperties.AutomationId="Library.SelectItems"
                                        Click="SelectLibraryItems_Click" l:Uids.Uid="Ui_WpLib_SelectItems_Menu"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem AutomationProperties.AutomationId="Library.ScreenFit"
                                        Click="ScreenFit_Click" l:Uids.Uid="Ui_ScreenFit_Menu"/>
                                    <MenuFlyoutItem AutomationProperties.AutomationId="Library.EffectPresets"
                                        Click="ManageEffectPresets_Click" l:Uids.Uid="Ui_EffectPreset_Manage"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
            </Grid>
        </NavigationView>
    </arc:ArcPageHost>
    </Grid>
</arc:ArcPage>
