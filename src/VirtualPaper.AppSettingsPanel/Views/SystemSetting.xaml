<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.AppSettingsPanel.Views.SystemSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.AppSettingsPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"    
    NavigationCacheMode="Enabled">

    <ScrollView>
        <StackPanel Margin="16 12 16 16" Spacing="16" Orientation="Vertical">
            <StackPanel x:Name="Developer" Spacing="8" Orientation="Vertical">
                <TextBlock x:Name="DeveloperHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_System_Text_Developer_Text"
                    FontWeight="Bold"/>

                <Grid x:Name="Debug"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xEC7A;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_System_Developer_Debug_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_System_Developer_DebugExplain_Text"/>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Width="200"
                        l:Uids.Uid="Ui_Settings_System_Text_Debug_Content"
                        Command="{x:Bind _viewModel.DebugCommand}"/>
                </Grid>

                <Grid x:Name="Log"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE9F9;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_System_Developer_Log_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_System_Developer_LogExplain_Text"/>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Width="200"
                        AutomationProperties.AutomationId="Settings.System.ExportLogs"
                        l:Uids.Uid="Ui_Text_Save_Content"
                        Command="{x:Bind _viewModel.LogCommand}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
