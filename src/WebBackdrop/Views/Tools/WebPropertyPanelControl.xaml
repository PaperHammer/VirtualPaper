<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebPropertyPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TabView
        IsAddTabButtonVisible="False"
        TabWidthMode="SizeToContent"
        CloseButtonOverlayMode="Always"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <TabViewItem Header="Properties" IsClosable="False">
            <Grid Padding="12 10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <StackPanel x:Name="NameRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Name"/>
                            <TextBlock x:Name="FileNameText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="LanguageRow" Spacing="4">
                            <TextBlock x:Name="LanguageLabel" FontSize="11" Opacity="0.6" Text="Language"/>
                            <TextBlock x:Name="LanguageText"/>
                        </StackPanel>

                        <StackPanel x:Name="StatusRow" Spacing="4">
                            <TextBlock x:Name="StatusLabel" FontSize="11" Opacity="0.6" Text="Status"/>
                            <TextBlock x:Name="StatusText"/>
                        </StackPanel>

                        <StackPanel x:Name="SizeRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Size"/>
                            <TextBlock x:Name="SizeText"/>
                        </StackPanel>

                        <StackPanel x:Name="LineCountRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Lines"/>
                            <TextBlock x:Name="LineCountText"/>
                        </StackPanel>

                        <StackPanel x:Name="CreatedRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Created"/>
                            <TextBlock x:Name="CreatedText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="ModifiedRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Modified"/>
                            <TextBlock x:Name="ModifiedText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="PathRow" Spacing="4">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Path"/>
                            <TextBlock x:Name="PathText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabViewItem>

        <TabViewItem Header="Preview" IsClosable="False">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <WebView2
                    x:Name="previewWebView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            </Grid>
        </TabViewItem>
    </TabView>
</UserControl>
