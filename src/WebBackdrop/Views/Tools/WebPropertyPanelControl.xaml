<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebPropertyPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12 10 0 10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0 0 16 0">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Project Inspector"/>

                <Expander x:Name="projExpander"
                    Header="Wallpaper" 
                    IsExpanded="True"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Title"/>
                            <TextBlock x:Name="ProjectTitleText" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="0.6" Text="Entry"/>
                            <TextBlock x:Name="ProjectEntryText" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander x:Name="currentItemExpander"
                    Header="Current" 
                    IsExpanded="True" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="NoItemPanel" Spacing="4">
                            <TextBlock Opacity="0.65" Text="No item selected."/>
                        </StackPanel>

                        <StackPanel x:Name="ItemInfoPanel" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Name"/>
                                <TextBlock x:Name="FileNameText" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TypeLabel" FontSize="11" Opacity="0.6" Text="Type"/>
                                <TextBlock x:Name="TypeText" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel x:Name="StatusRow" Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Status"/>
                                <TextBlock x:Name="StatusText"/>
                            </StackPanel>
                            <StackPanel x:Name="SizeRow" Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Size"/>
                                <TextBlock x:Name="SizeText"/>
                            </StackPanel>
                            <StackPanel x:Name="LineCountRow" Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Lines"/>
                                <TextBlock x:Name="LineCountText"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Modified"/>
                                <TextBlock x:Name="ModifiedText" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="11" Opacity="0.6" Text="Relative Path"/>
                                <TextBlock x:Name="RelativePathText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander x:Name="previewExpander"
                    Header="Preview" 
                    IsExpanded="True" 
                    HorizontalAlignment="Stretch"  
                    HorizontalContentAlignment="Stretch">
                    <Border x:Name="PreviewWebViewHost"
                        MinHeight="160"
                        CornerRadius="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        SizeChanged="PreviewWebViewHost_SizeChanged">
                        <WebView2 x:Name="previewWebView"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
