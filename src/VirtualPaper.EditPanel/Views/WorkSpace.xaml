<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.EditPanel.Views.WorkSpace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.EditPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cmd="using:VirtualPaper.UIComponent.Command"
    xmlns:navi="using:VirtualPaper.UIComponent.Navigation"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <cmd:KeepToLeft x:Key="LeftMenuItems">
            <MenuBarItem AutomationProperties.AutomationId="Project.File" l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_File_Title" KeyboardAcceleratorPlacementMode="Hidden">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="F"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_CreateNew_Text" Click="MFI_CreateNew_Clicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem AutomationProperties.AutomationId="Project.File.Open" l:Uids.Uid="Ui_Project_Open_Text" Command="{x:Bind _viewModel.MFI_OpenCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem AutomationProperties.AutomationId="Project.File.Save" l:Uids.Uid="Ui_Text_Save_Text" Command="{x:Bind _viewModel.MFI_SaveCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="saveAsMenuItem" AutomationProperties.AutomationId="Project.File.SaveAs" l:Uids.Uid="Ui_Text_Save_As_Text" Command="{x:Bind _viewModel.MFI_SaveAsCommand}"/>
                <MenuFlyoutItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_SaveAll_Text" Command="{x:Bind _viewModel.MFI_SaveAllCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="ExportMenuSubItem" AutomationProperties.AutomationId="Project.File.Export" l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Export_Text">
                    <MenuFlyoutItem x:Name="ExportPngMenuItem" AutomationProperties.AutomationId="Project.File.ExportPng" Text="PNG" Tag="Png" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportBmpMenuItem" Text="BMP" Tag="Bmp" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportJpegMenuItem" Text="JPEG" Tag="Jpeg" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportJpegXrMenuItem" Text="JPEG XR" Tag="JpegXR" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportFullZipMenuItem" AutomationProperties.AutomationId="Project.File.ExportFullZip" l:Uids.Uid="Ui_WebBackdrop_FullProjectArchive_Text" Tag="FullZip" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportZipMenuItem" l:Uids.Uid="Ui_WebBackdrop_WebWallpaperPackage_Text" Tag="Zip" Click="OnExportMenuItemClick"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem l:Uids.Uid="Ui_Text_ImportLib_Text" Click="OnAddToLibraryMenuItemClick"/>
                <MenuFlyoutItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Exit_Text" Click="MFI_Exit_Clicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F4"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="EditMenuBarItem" l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Edit_Title"
                KeyboardAcceleratorPlacementMode="Hidden" PointerEntered="EditMenuBarItem_PointerEntered">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="E"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem x:Name="UndoMenuItem" l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Undo_Text"
                    Tag="Undo" Click="UndoRedoMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Redo_Text"
                    Tag="Redo" Click="UndoRedoMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="Z"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator x:Name="WebEditFileSeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebCutMenuItem" l:Uids.Uid="Ui_WebBackdrop_Cut_Text" Tag="Cut" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+X" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyMenuItem" l:Uids.Uid="Ui_WebBackdrop_Copy_Text" Tag="Copy" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebPasteMenuItem" l:Uids.Uid="Ui_WebBackdrop_Paste_Text" Tag="Paste" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+V" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyPathMenuItem" l:Uids.Uid="Ui_WebBackdrop_CopyPath_Text" Tag="CopyPath" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Shift+Alt+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyRelativePathMenuItem" l:Uids.Uid="Ui_WebBackdrop_CopyRelativePath_Text" Tag="CopyRelativePath" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="WebEditModifySeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebRenameMenuItem" l:Uids.Uid="Ui_WebBackdrop_Rename_Text" Tag="Rename" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="F2" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebDeleteMenuItem" l:Uids.Uid="Ui_WebBackdrop_Delete_Text" Tag="Delete" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Del" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="WebEditFindSeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebFindMenuItem" l:Uids.Uid="Ui_WebBackdrop_Find_Text" Tag="Find" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+P" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebFindInFilesMenuItem" l:Uids.Uid="Ui_WebBackdrop_FindInFiles_Text" Tag="FindInFiles" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+F" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="F"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="WebSelectionMenuBarItem" l:Uids.Uid="Ui_WebBackdrop_Selection_Title" Visibility="Collapsed"
                KeyboardAcceleratorPlacementMode="Hidden" PointerEntered="EditMenuBarItem_PointerEntered">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="S"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem x:Name="WebNavigateBackMenuItem" l:Uids.Uid="Ui_WebBackdrop_GoBack_Text" Tag="NavigateBack"
                    KeyboardAcceleratorTextOverride="Alt+Left" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Left"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebNavigateForwardMenuItem" l:Uids.Uid="Ui_WebBackdrop_GoForward_Text" Tag="NavigateForward"
                    KeyboardAcceleratorTextOverride="Alt+Right" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Right"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="WebCopyLineUpMenuItem" l:Uids.Uid="Ui_WebBackdrop_CopyLineUp_Text" Tag="CopyLineUp"
                    KeyboardAcceleratorTextOverride="Shift+Alt+Up" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="Up"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyLineDownMenuItem" l:Uids.Uid="Ui_WebBackdrop_CopyLineDown_Text" Tag="CopyLineDown"
                    KeyboardAcceleratorTextOverride="Shift+Alt+Down" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="Down"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebMoveLineUpMenuItem" l:Uids.Uid="Ui_WebBackdrop_MoveLineUp_Text" Tag="MoveLineUp"
                    KeyboardAcceleratorTextOverride="Alt+Up" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Up"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebMoveLineDownMenuItem" l:Uids.Uid="Ui_WebBackdrop_MoveLineDown_Text" Tag="MoveLineDown"
                    KeyboardAcceleratorTextOverride="Alt+Down" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Down"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </cmd:KeepToLeft>

        <cmd:KeepToRight x:Key="RightMenuItems">
            <MenuBarItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Help_Title" KeyboardAcceleratorPlacementMode="Hidden">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="H"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_Manual_Text" Command="{x:Bind _viewModel.MFI_ManualCommand}"/>

                <MenuFlyoutItem l:Uids.Uid="Ui_Project_StaticImg_MenuBar_Text_About_Text" Command="{x:Bind _viewModel.MFI_AboutCommand}"/>
            </MenuBarItem>
        </cmd:KeepToRight>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="menuContent"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <cmd:ObservableMenuBar
                    Grid.ColumnSpan="3"
                    KeepToLeft="{StaticResource LeftMenuItems}"
                    KeepToRight="{StaticResource RightMenuItems}"
                    MiddleItems="{x:Bind _viewModel._middleMenuItems}"/>
                <ContentControl x:Name="runtimeTopBarContent"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </ContentControl>

        <Grid x:Name="contentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabView x:Name="TabViewControl"
                Loaded="TabViewControl_Loaded"
                TabWidthMode="SizeToContent"
                SelectedIndex="{x:Bind _viewModel.SelectedTabIndex, Mode=TwoWay}"
                TabItemsSource="{x:Bind _viewModel.TabViewItems}"
                CloseButtonOverlayMode="OnPointerOver"
                TabItemsChanged="TabViewControl_TabItemsChanged"   
                SelectionChanged="TabViewControl_SelectionChanged"
                AddTabButtonClick="TabViewControl_AddTabButtonClick"
                TabCloseRequested="TabViewControl_TabCloseRequested" />

            <Grid x:Name="workspaceContentPool" Grid.Row="1" />
        </Grid>

        <Grid x:Name="maskGrid" 
            Grid.RowSpan="2" 
            Background="#80000000" 
            Visibility="Collapsed"
            Tapped="MaskGrid_Tapped">

            <Frame x:Name="overlayFrame" 
                Width="970" 
                Height="680"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Tapped="OverlayFrame_Tapped"/>
        </Grid>
    </Grid>
</arc:ArcPage>
