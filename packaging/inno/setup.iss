; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#include "CodeDependencies.iss"

#define AppId "{{95F4CECE-7C7C-40E1-B485-07DA64D1905F}"
#define MyAppName "Virtual Paper"
#define MyAppVersion "0.6.0.0"
#define MyAppVersionText "0_6_0_0"
#define MyAppPublisher "PaperHammer"
#define MyAppURL "https://github.com/PaperHammer/VirtualPaper"
#define MyAppExeName "VirtualPaper.exe"
; Must match Constants.CoreField.AppName in VirtualPaper.Common\Constants.cs
#define MyAppDataFolderName "VirtualPaper"

; Generate on every compile, including direct compilation in the Inno Setup IDE.
#define LocalizationScript SourcePath + "..\..\localization\Generate-Resources.ps1"
#define LocalizationOutput SourcePath + "obj\Localization"
#if Exec("powershell.exe", "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File " + AddQuotes(LocalizationScript) + " -Target Installer -OutputRoot " + AddQuotes(LocalizationOutput), SourcePath, 1) != 0
  #error "Localization generation failed."
#endif
#include "obj\Localization\Localization.iss"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={#AppId}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppMutex=Virtual:WALLPAPERSYSTEM
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
AppCopyright=Virtual@PaperHammer
VersionInfoVersion={#MyAppVersion}
VersionInfoProductName={#MyAppName}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName} Installer
DefaultDirName={autopf}\{#MyAppName}
ChangesAssociations=yes
DisableProgramGroupPage=yes
OutputBaseFilename=virtualpaper_setup_x64_full_v{#MyAppVersionText}
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
Compression=lzma
SolidCompression=yes
WizardStyle=modern
SetupIconFile=Icons\virtualpaper.ico
WizardSmallImageFile=Themes\wizard_small.bmp
WizardImageFile=Themes\wizard_large.bmp
LicenseFile=License\LICENSE.txt
Uninstallable=true
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.19041
UsePreviousAppDir=yes

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; Name: "windowsstartup"; Description: "{cm:AutoStartProgram,{#MyAppName}}"

#include "BuiltInWallpapers.iss"

[Files]
Source: "..\..\src\VirtualPaper\bin\Release\net10.0-windows10.0.19041.0\*"; DestDir: "{app}"; Excludes: "*.pdb,*.xml,*.WebView2,*.WebView2\*,BuiltInWallpapers\*"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\.vpd\OpenWithProgids"; ValueType: string; ValueName: "VirtualPaper.Design"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\.vpw\OpenWithProgids"; ValueType: string; ValueName: "VirtualPaper.Web"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\.vpd"; ValueType: string; ValueData: "VirtualPaper.Design"; Check: CanAssociateProject('.vpd')
Root: HKA; Subkey: "Software\Classes\.vpw"; ValueType: string; ValueData: "VirtualPaper.Web"; Check: CanAssociateProject('.vpw')
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Design"; ValueType: string; ValueData: "{cm:DesignFileType}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Design\DefaultIcon"; ValueType: string; ValueData: """{app}\FileIcons\vpd.ico"""
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Design\shell\open"; ValueType: string; ValueData: "{cm:OpenWithVirtualPaper}"
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Design\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" --open-project ""%1"""
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Web"; ValueType: string; ValueData: "{cm:WebFileType}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Web\DefaultIcon"; ValueType: string; ValueData: """{app}\FileIcons\vpw.ico"""
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Web\shell\open"; ValueType: string; ValueData: "{cm:OpenWithVirtualPaper}"
Root: HKA; Subkey: "Software\Classes\VirtualPaper.Web\shell\open\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" --open-project ""%1"""
; Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "VirtualPaper"; ValueData: """{app}\VirtualPaper.exe"""; Flags: uninsdeletevalue; Tasks:windowsstartup

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall; Check: AutoLaunch

[UninstallDelete]
Type: files; Name: "{app}\installer-language.txt"

[Code]
function CanAssociateProject(Extension: String): Boolean;
var
  Current: String;
begin
  Result := not RegQueryStringValue(HKA, 'Software\Classes\' + Extension, '', Current) or (Current = '');
end;

procedure RemoveProjectAssociation(Extension, ProgId: String);
var
  Current: String;
begin
  // Remove only our fallback association; leave any newer choice and other type metadata intact.
  if RegQueryStringValue(HKA, 'Software\Classes\' + Extension, '', Current) and (Current = ProgId) then
    RegDeleteValue(HKA, 'Software\Classes\' + Extension, '');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
    // Read only when the application creates a new user settings file.
    if not SaveStringToFile(ExpandConstant('{app}\installer-language.txt'), ExpandConstant('{cm:InitialApplicationLanguage}'), False) then
      RaiseException(ExpandConstant('{cm:InitialLanguageSaveFailed}'));
end;

// Register once; CodeDependencies.iss owns its annotated wizard/install events.
procedure InitializeWizard;
begin
  // Every shipped process is x64, including on ARM64 Windows via emulation.
  Dependency_ForceX64 := True;
  Dependency_AddDotNet100Desktop;
  // The UI's local Web preview server requires ASP.NET Core as well.
  Dependency_AddDotNet100Asp;
end;

// The dependency handler runs first, for interactive and silent upgrades alike.
// Never complete installation after an ignored/failed prerequisite installation.
function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  if not Dependency_IsNetCoreInstalled('Microsoft.WindowsDesktop.App', 10, 0, {#Dependency_DotNet100Revision}) then
    Result := '.NET Desktop Runtime {#Dependency_DotNet100Version} (x64)'
  else if not Dependency_IsNetCoreInstalled('Microsoft.AspNetCore.App', 10, 0, {#Dependency_DotNet100Revision}) then
    Result := 'ASP.NET Core Runtime {#Dependency_DotNet100Version} (x64)';
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    RemoveProjectAssociation('.vpd', 'VirtualPaper.Design');
    RemoveProjectAssociation('.vpw', 'VirtualPaper.Web');
    if SuppressibleMsgBox(
         ExpandConstant('{cm:DeleteEverythigMsgBox}') + ' ' +
         ExpandConstant('{localappdata}\{#MyAppDataFolderName}'),
         mbConfirmation, MB_YESNO, IDNO) = IDYES then
    begin
      DelTree(ExpandConstant('{localappdata}\{#MyAppDataFolderName}'), True, True, True);
    end;
  end;
end;

function InitializeUninstall(): Boolean;
var
  ErrorCode: Integer;
begin
  Result := True;
  if CheckForMutexes('Virtual:WALLPAPERSYSTEM') then
  begin
    if SuppressibleMsgBox(ExpandConstant('{cm:ClosingMsgBox}'),
         mbConfirmation, MB_OKCANCEL, IDOK) = IDOK then
    begin
      ShellExec('open', 'taskkill.exe', '/f /im {#MyAppExeName}',
        '', SW_HIDE, ewWaitUntilTerminated, ErrorCode);
      Result := True;
    end
    else
      Result := False;
  end;
end;

function CmdLineParamNotExists(const Value: string): Boolean;
var
  I: Integer;
begin
  Result := True;
  for I := 1 to ParamCount do
    if CompareText(ParamStr(I), Value) = 0 then
    begin
      Result := False;
      Exit;
    end;
end;

function AutoLaunch(): Boolean;
begin
  // /NOAUTOLAUNCH 显式禁止，或 /VERYSILENT（CI 静默安装）时不自动启动
  // /SILENT（业务自动更新）时仍正常重启 App
  Result := CmdLineParamNotExists('/NOAUTOLAUNCH') and CmdLineParamNotExists('/VERYSILENT');
end;
