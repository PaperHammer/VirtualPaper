<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Components.BottomPanels.WebProblemsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Components.BottomPanels"
    xmlns:collection="using:VirtualPaper.UIComponent.Collection"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///WebBackdrop/Themes/WebBackdropColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="FileTemplate" x:DataType="local:ProblemFileGroup">
            <collection:ArcTreeViewItem
                AutomationProperties.Name="{x:Bind FileName}"
                ItemsSource="{x:Bind Items}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Grid Padding="0" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path
                        Width="18"
                        Height="18"
                        Data="{x:Bind IconDataResourceKey, Mode=OneWay, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                        Fill="{x:Bind IconBrush, Mode=OneWay}"
                        Stretch="Uniform"
                        UseLayoutRounding="True"/>
                    <TextBlock
                        Grid.Column="1"
                        FontSize="14"
                        LineHeight="22"
                        Text="{x:Bind FileName}"/>
                    <TextBlock
                        Grid.Column="2"
                        FontSize="14"
                        Opacity="0.65"
                        Text="{x:Bind RelativeDirectory}"/>
                    <Border
                        Grid.Column="3"
                        MinWidth="18"
                        Height="18"
                        CornerRadius="8"
                        Background="{ThemeResource WebBackdropProblemBadgeCountBackgroundBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource WebBackdropProblemBadgeForegroundBrush}"
                            Text="{x:Bind CountText, Mode=OneWay}"/>
                    </Border>
                </Grid>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="ProblemTemplate" x:DataType="local:ProblemItem">
            <collection:ArcTreeViewItem AutomationProperties.Name="{x:Bind Message}">
                <Grid Padding="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Margin="0 2 0 0"
                        Glyph="{x:Bind Glyph}"
                        FontSize="14"
                        Foreground="{ThemeResource WebBackdropProblemErrorBrush}"
                        Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"/>
                    <FontIcon
                        Margin="0 2 0 0"
                        Glyph="{x:Bind Glyph}"
                        FontSize="14"
                        Foreground="{ThemeResource WebBackdropProblemWarningBrush}"
                        Visibility="{x:Bind WarningVisibility, Mode=OneWay}"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            FontSize="12"
                            VerticalAlignment="Center"
                            Text="{x:Bind Message}"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock
                            FontSize="12"
                            VerticalAlignment="Center"
                            Opacity="0.65"
                            Text="{x:Bind SourceText}"/>
                        <TextBlock
                            FontSize="12"
                            VerticalAlignment="Center"
                            Opacity="0.65"
                            Text="{x:Bind PositionText}"/>
                    </StackPanel>
                </Grid>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="OverflowTemplate" x:DataType="local:ProblemOverflowItem">
            <collection:ArcTreeViewItem AutomationProperties.Name="{x:Bind Text}">
                <TextBlock
                    Margin="18 0 0 0"
                    FontSize="12"
                    Opacity="0.65"
                    Text="{x:Bind Text}"/>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <local:ProblemTreeItemTemplateSelector
            x:Key="ProblemTreeItemTemplateSelector"
            FileTemplate="{StaticResource FileTemplate}"
            ProblemTemplate="{StaticResource ProblemTemplate}"
            OverflowTemplate="{StaticResource OverflowTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <collection:ArcTreeView
        x:Name="problemsTreeView"
        CancelSelectionEnable="False"
        ItemMinHeight="24"
        ItemContentHeight="24"
        ItemPresenterPadding="0"
        ItemPresenterMargin="0"
        ItemsSource="{x:Bind Items, Mode=OneWay}"
        ItemTemplateSelector="{StaticResource ProblemTreeItemTemplateSelector}"
        ItemInvoked="ProblemsTreeView_ItemInvoked"/>
</UserControl>
