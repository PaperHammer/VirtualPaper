<?xml version="1.0" encoding="utf-8"?>
<dialogs:ArcContentDialog
    x:Class="VirtualPaper.WpSettingsPanel.Views.ScreenFitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:dialogs="using:VirtualPaper.UIComponent.Dialogs"
    xmlns:library="using:VirtualPaper.WpSettingsPanel.Utils"
    DialogWidth="540" DialogMaxHeight="760"
    l:Uids.Uid="Ui_ScreenFit_Title_Title__Text_Apply_PrimaryButtonText__Text_Cancel_CloseButtonText"


    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
    PrimaryButtonClick="Apply_Click"
    Opened="Dialog_Opened"
    Closed="Dialog_Closed"
    Closing="Dialog_Closing">
    <dialogs:ArcContentDialog.Resources>
        <library:WallpaperSourceThumbnailConverter x:Key="SourceThumbnailConverter"/>
    </dialogs:ArcContentDialog.Resources>
    <StackPanel x:Name="FitContent" Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.LayoutMessage}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Visibility="{x:Bind ViewModel.LayoutMessage, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"/>
        <Grid>
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8" MinHeight="32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DropDownButton x:Name="SelectImageButton" AutomationProperties.AutomationId="ScreenFit.SelectImage"
                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" l:Uids.Uid="Ui_ScreenFit_SelectImage_Content">
                        <DropDownButton.Flyout>
                            <Flyout x:Name="SourceFlyout" Placement="BottomEdgeAlignedLeft" Opened="SourceFlyout_Opened" Closed="SourceFlyout_Closed">
                                <Grid Width="400" Height="380" RowSpacing="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <AutoSuggestBox x:Name="SourceSearch" Height="36" QueryIcon="Find" TextChanged="SourceSearch_TextChanged"
                                            l:Uids.Uid="Ui_EffectPreset_SourceSearch" AutomationProperties.AutomationId="ScreenFit.Source.Search"/>
                                        <ToggleButton x:Name="SourceFavorites" Grid.Column="1" Height="36" Padding="10 0" CornerRadius="6"
                                            Checked="SourceFavorites_Changed" Unchecked="SourceFavorites_Changed"
                                            l:Uids.Uid="Ui_WpLib_Favorites" AutomationProperties.AutomationId="ScreenFit.Source.FavoritesOnly"/>
                                    </Grid>
                                    <ListView x:Name="SourcePicker" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Source_ItemClick"
                                        AutomationProperties.AutomationId="ScreenFit.Source.List" ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="6"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="library:WallpaperIndexEntry">
                                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                    AutomationProperties.AutomationId="{x:Bind Uid}" AutomationProperties.Name="{x:Bind DisplayName}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="72" Height="44" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon x:Name="SourceNoPreview" Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                AutomationProperties.AccessibilityView="Raw" Visibility="{x:Bind ThumbnailPath, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}"/>
                                                            <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource SourceThumbnailConverter}}" Stretch="UniformToFill"
                                                                ImageFailed="SourceThumbnail_ImageFailed" AutomationProperties.AccessibilityView="Raw"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                        <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="SourceEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" l:Uids.Uid="Ui_EffectPreset_SourceEmpty"/>
                                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Click="BrowseImage_Click" l:Uids.Uid="Ui_ScreenFit_BrowseFile"
                                        AutomationProperties.AutomationId="ScreenFit.BrowseFile"/>
                                </Grid>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ProgressRing x:Name="SourceLoading" Grid.Column="1" Width="20" Height="20" IsActive="False" Opacity="0"
                        AutomationProperties.AutomationId="ScreenFit.Loading" l:Uids.Uid="Ui_ScreenFit_Loading"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SourcePath, Mode=OneWay}" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"
                        TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind ViewModel.SourcePath, Mode=OneWay}"/>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}"
                        TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
                </Grid>
                <ContentControl x:Name="FitOptions" IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox AutomationProperties.AutomationId="ScreenFit.Monitor" l:Uids.Uid="Ui_ScreenFit_Monitor_Header" HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.Monitors}" DisplayMemberPath="Label"
                                SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1" AutomationProperties.AutomationId="ScreenFit.Mode" l:Uids.Uid="Ui_ScreenFit_Mode_Header" HorizontalAlignment="Stretch"
                                SelectedIndex="{x:Bind ViewModel.FitIndex, Mode=TwoWay}">
                                <ComboBoxItem l:Uids.Uid="Ui_ScreenFit_Contain_Content"/>
                                <ComboBoxItem l:Uids.Uid="Ui_ScreenFit_Cover_Content"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock l:Uids.Uid="Ui_ScreenFit_Preview_Text"/>
                        <Viewbox MaxWidth="460" StretchDirection="DownOnly">
                            <Border Width="{x:Bind ViewModel.PreviewWidth, Mode=OneWay}" Height="{x:Bind ViewModel.PreviewHeight, Mode=OneWay}"
                                Background="Black" HorizontalAlignment="Center">
                                <Grid>
                                    <Grid x:Name="DefaultPreviewPattern">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#182E50"/>
                                                <GradientStop Color="#52648E" Offset="0.65"/>
                                                <GradientStop Color="#A38BA9" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="460" Height="260">
                                                <Ellipse Canvas.Left="340" Canvas.Top="24" Width="64" Height="64" Fill="#F4D6AD"/>
                                                <Path Fill="#405775"
                                                    Data="M0,210 L100,105 L200,195 L305,130 L460,225 L460,260 L0,260 Z"/>
                                                <Path Fill="#263E5B"
                                                    Data="M0,205 C95,145 155,240 255,185 S385,145 460,195 L460,260 L0,260 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                            Padding="8 4" CornerRadius="4" Background="#99000000">
                                            <TextBlock AutomationProperties.AutomationId="ScreenFit.Sample" l:Uids.Uid="Ui_ScreenFit_PreviewSample_Text" FontSize="12" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <Image x:Name="PreviewImage" AutomationProperties.AutomationId="ScreenFit.Preview" l:Uids.Uid="Ui_ScreenFit_Preview_AutomationProperties_Name" Stretch="{x:Bind ViewModel.PreviewStretch, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </Viewbox>
                        <TextBlock AutomationProperties.AutomationId="ScreenFit.Plan" Text="{x:Bind ViewModel.PlanText, Mode=OneWay}" TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.PlanText, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"/>
                        <CheckBox AutomationProperties.AutomationId="ScreenFit.Enhance" l:Uids.Uid="Ui_ScreenFit_Enhance_Content" IsChecked="{x:Bind ViewModel.UseEnhancement, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.NeedsEnhancement, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.EnhancementText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                            Visibility="{x:Bind ViewModel.EnhancementText, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"/>
    </StackPanel>
</dialogs:ArcContentDialog>
