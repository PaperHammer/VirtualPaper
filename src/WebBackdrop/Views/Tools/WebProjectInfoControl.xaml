<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebProjectInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="12 8" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Opacity="0.6" l:Uids.Uid="Ui_WebBackdrop_Title_Text"/>
                <TextBox x:Name="titleBox" l:Uids.Uid="Ui_WebBackdrop_WallpaperTitle_PlaceholderText" Text="{x:Bind _viewModel.Title, Mode=TwoWay}" />
            </StackPanel>

            <!-- Description -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Opacity="0.6" l:Uids.Uid="Ui_WebBackdrop_Description_Text"/>
                <TextBox x:Name="descBox"
                    l:Uids.Uid="Ui_WebBackdrop_ShortDescription_PlaceholderText"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="72"
                    Text="{x:Bind _viewModel.Desc, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Author -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Opacity="0.6" l:Uids.Uid="Ui_WebBackdrop_Author_Text"/>
                <TextBox x:Name="authorBox" l:Uids.Uid="Ui_WebBackdrop_AuthorName_PlaceholderText" Text="{x:Bind _viewModel.Authors, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Tags -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Opacity="0.6" l:Uids.Uid="Ui_WebBackdrop_Tags_Text"/>
                <TextBox x:Name="tagsBox" PlaceholderText="tag1; tag2" Text="{x:Bind _viewModel.Tags, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Entry file -->
            <StackPanel Spacing="4">
                <TextBlock FontSize="11" Opacity="0.6" l:Uids.Uid="Ui_WebBackdrop_EntryFile_Text"/>
                <TextBox x:Name="entryFileBox" PlaceholderText="index.html" Text="{x:Bind _viewModel.File, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Save button -->
            <Button
                HorizontalAlignment="Stretch"
                l:Uids.Uid="Ui_WebBackdrop_SaveProjectJson_Content"
                Command="{x:Bind _viewModel.SaveCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
