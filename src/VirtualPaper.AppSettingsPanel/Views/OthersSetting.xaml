<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.AppSettingsPanel.Views.OthersSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <Style x:Key="OtherLinkCardStyle" TargetType="HyperlinkButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="Padding" Value="20 12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="OtherLinkDescriptionStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollView>
        <StackPanel Margin="16 12 16 16" Spacing="16">
            <StackPanel x:Name="Abount" Spacing="8">
                <TextBlock x:Name="AbountHeader"
                    l:Uids.Uid="Ui_Settings_Others_Text_About_Text" FontWeight="Bold"/>
                <Border x:Name="Basic" Padding="20" CornerRadius="12"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AboutLogo" Width="96" Height="96" VerticalAlignment="Top"
                            AutomationProperties.AutomationId="Settings.Others.AboutLogo"
                            Stretch="Uniform" AutomationProperties.Name="Virtual Paper"
                            Source="ms-appx:///Assets/splashCol_1400x1400_with_round40.png"/>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Virtual Paper" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_About_Basic_Text"
                                TextWrapping="Wrap" LineHeight="22"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="More" Spacing="8">
                <TextBlock x:Name="MoreHeader"
                    l:Uids.Uid="Ui_Settings_Others_Text_More_Text" FontWeight="Bold"/>
                <HyperlinkButton Style="{StaticResource OtherLinkCardStyle}"
                    NavigateUri="https://github.com/PaperHammer/virtualpaper/wiki">
                    <Grid x:Name="Document" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE736;" FontSize="20"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_Document_Text" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_DocumentExplain_Text"
                                Style="{StaticResource OtherLinkDescriptionStyle}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="16"/>
                    </Grid>
                </HyperlinkButton>
                <HyperlinkButton Style="{StaticResource OtherLinkCardStyle}"
                    NavigateUri="https://github.com/PaperHammer/virtualpaper">
                    <Grid x:Name="SourceCode" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE716;" FontSize="20"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_SourceCode_Text" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_SourceCodeExplain_Text"
                                Style="{StaticResource OtherLinkDescriptionStyle}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="16"/>
                    </Grid>
                </HyperlinkButton>
                <HyperlinkButton Style="{StaticResource OtherLinkCardStyle}"
                    NavigateUri="{x:Bind _viewModel.More_RequestFunc_Link}">
                    <Grid x:Name="RequestFunc" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF4A5;" FontSize="20"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_RequestFunc_Text" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_RequestFuncExplain_Text"
                                Style="{StaticResource OtherLinkDescriptionStyle}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="16"/>
                    </Grid>
                </HyperlinkButton>
                <HyperlinkButton Style="{StaticResource OtherLinkCardStyle}"
                    NavigateUri="https://github.com/PaperHammer/virtualpaper/issues">
                    <Grid x:Name="ReportBug" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEBE8;" FontSize="20"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_ReportBug_Text" FontWeight="SemiBold"/>
                            <TextBlock l:Uids.Uid="Ui_Settings_Others_More_ReportBugExplain_Text"
                                Style="{StaticResource OtherLinkDescriptionStyle}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="16"/>
                    </Grid>
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
