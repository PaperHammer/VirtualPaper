<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\test\LocalizedTestStrings.cs" Link="Support\LocalizedTestStrings.cs" />
    <EmbeddedResource Include="..\..\localization\LanguageCatalog.json" LogicalName="VirtualPaper.LanguageCatalog.json" />
    <EmbeddedResource Include="..\..\localization\Strings\**\Resources.resw"
                      LogicalName="VirtualPaper.Localization.Source.%(RecursiveDir)Resources.resw" />
    <EmbeddedResource Include="..\..\resources\BuiltInWallpapers\**\wp_metadata_basic.json"
                      LogicalName="VirtualPaper.BuiltIn.%(RecursiveDir)wp_metadata_basic.json" />
    <EmbeddedResource Include="..\VirtualPaper.UIComponent\Localization\XamlResources.xml"
                      LogicalName="VirtualPaper.XamlResources.xml" />
  </ItemGroup>

</Project>
