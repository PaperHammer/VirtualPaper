<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VirtualPaper.IntelligentPanel.Views.StyleTransferComp.StyleTransferIntroduction"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.IntelligentPanel.Views.StyleTransferComp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="demoCrossfadeStoryboard"
                    RepeatBehavior="Forever">
            <!-- 停 1s → 淡入 0.5s → 停 2s → 淡出 0.5s → 停 1s，总循环 5s -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="resultImage"
                                           Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1"   Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4"   Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5"   Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="originImage"
                                           Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1"   Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:4"   Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:5"   Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid SizeChanged="IntroductionRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="PreviewColumn.Width" Value="480"/>
                        <Setter Target="IntroductionGap.Width" Value="24"/>
                        <Setter Target="IntroductionTextColumn.Width" Value="*"/>
                        <Setter Target="IntroductionText.(Grid.Row)" Value="0"/>
                        <Setter Target="IntroductionText.(Grid.Column)" Value="2"/>
                        <Setter Target="IntroductionText.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="PreviewColumn.Width" Value="*"/>
                        <Setter Target="IntroductionGap.Width" Value="0"/>
                        <Setter Target="IntroductionTextColumn.Width" Value="0"/>
                        <Setter Target="IntroductionText.(Grid.Row)" Value="1"/>
                        <Setter Target="IntroductionText.(Grid.Column)" Value="0"/>
                        <Setter Target="IntroductionText.Margin" Value="0,24,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Margin="24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Grid x:Name="introductionGrid" MaxWidth="904"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                    <ColumnDefinition x:Name="IntroductionGap" Width="0"/>
                    <ColumnDefinition x:Name="IntroductionTextColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Viewbox MaxWidth="480" Stretch="Uniform" StretchDirection="DownOnly">
                    <Border Width="480"
                        Height="270"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="originImage"
                                   Source="{x:Bind _intelli_Demo_StyleTransfer_Origin, Converter={StaticResource ResourceKeyToImageConverter}}"
                                   Stretch="UniformToFill"
                                   Opacity="1"/>

                            <Image x:Name="resultImage"
                                   Source="{x:Bind _intelli_Demo_StyleTransfer_Result, Converter={StaticResource ResourceKeyToImageConverter}}"
                                   Stretch="UniformToFill"
                                   Opacity="0"/>
                        </Grid>
                    </Border>
                </Viewbox>

                <StackPanel x:Name="IntroductionText"
                    Grid.Row="1" Margin="0,24,0,0"
                    MaxWidth="400"
                    Spacing="12">

                    <TextBlock
                        l:Uids.Uid="Ui_Intelligent_Intro_Title_Text"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        l:Uids.Uid="Ui_Intelligent_Intro_Desc_Text"
                        FontSize="14"
                        LineHeight="24"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        l:Uids.Uid="Ui_Intelligent_Intro_Warning_Text"
                        FontSize="14"
                        LineHeight="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
