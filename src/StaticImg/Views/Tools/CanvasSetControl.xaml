<?xml version="1.0" encoding="utf-8"?>
<arc:ArcUserControl
    x:Class="Workloads.Creation.StaticImg.Views.Tools.CanvasSetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:VirtualPaper.UIComponent.Layout"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Workloads.Creation.StaticImg.Views.Tools"
    xmlns:root="using:Workloads.Creation.StaticImg"
    xmlns:i18n="using:VirtualPaper.UIComponent.Extensions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d">

    <layout:ArcExpander AutomationProperties.AutomationId="StaticEditor.Canvas" Style="{StaticResource RightExpanderStyle}">
        <layout:ArcExpander.Header>
            <TextBlock l:Uids.Uid="Ui_SIG_CanvasSet_Header_Text"/>
        </layout:ArcExpander.Header>
        <layout:ArcExpander.Content>
            <StackPanel Spacing="10">
                <TextBlock l:Uids.Uid="Ui_SIG_CanvasSet_AdjustSize_Text" FontSize="12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock                                                         
                            l:Uids.Uid="Ui_SIG_CanvasSet_PixelWidth_Text"
                            FontSize="12"
                            VerticalAlignment="Center"/>
                        <TextBox x:Name="widthTextBox"
                            AutomationProperties.AutomationId="StaticEditor.Width"
                            InputScope="Digits"
                            LostFocus="OnSizeBoxLostFocus"
                            KeyDown="OnSizeBoxKeyDown"
                            Text="{x:Bind Size.Width, Mode=OneWay}"
                            FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock 
                            l:Uids.Uid="Ui_SIG_CanvasSet_PixelHeight_Text"
                            FontSize="12"
                            VerticalAlignment="Center"/>
                        <TextBox x:Name="heightTextBox"
                            AutomationProperties.AutomationId="StaticEditor.Height"
                            InputScope="Digits"
                            LostFocus="OnSizeBoxLostFocus"
                            KeyDown="OnSizeBoxKeyDown"
                            Text="{x:Bind Size.Height, Mode=OneWay}"
                            FontSize="12"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="lockAspectRatio"
                    l:Uids.Uid="Ui_SIG_CanvasSet_LockAspectRatio_Content"
                    Checked="LockAspectRatio_Checked"
                    Unchecked="LockAspectRatio_Unchecked"
                    FontSize="12"/>

                <CheckBox x:Name="scaleContent"
                    l:Uids.Uid="Ui_SIG_CanvasSet_SacleContent_Content"
                    Checked="SacleContent_Checked"
                    Unchecked="SacleContent_Unchecked"
                    FontSize="12"/>

                <StackPanel Spacing="6">
                    <TextBlock 
                        l:Uids.Uid="Ui_SIG_CanvasSet_RotateAndFlip_Text"
                        FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="rotateLeft"
                            AutomationProperties.AutomationId="StaticEditor.RotateLeft"
                            Height="45"
                            Width="45"
                            Command="{x:Bind CanvasOperationCommand}"
                            CommandParameter="{x:Bind root:CanvasOperation.RotateLeft}">
                            <ToolTipService.ToolTip>
                                <ToolTip Placement="Mouse" l:Uids.Uid="Ui_SIG_CanvasSet_RotateLeftNinety_Content" Visibility="Visible" />
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Rotate">
                                <SymbolIcon.RenderTransform>
                                    <ScaleTransform CenterX="10" ScaleX="-1" ScaleY="1"/>
                                </SymbolIcon.RenderTransform>
                            </SymbolIcon>
                        </Button>

                        <Button x:Name="rotateRight"
                            Grid.Column="1" 
                            Height="45"
                            Width="45"
                            Command="{x:Bind CanvasOperationCommand}"
                            CommandParameter="{x:Bind root:CanvasOperation.RotateRight}">
                            <ToolTipService.ToolTip>
                                <ToolTip Placement="Mouse" l:Uids.Uid="Ui_SIG_CanvasSet_RotateRightNinety_Content" Visibility="Visible" />
                            </ToolTipService.ToolTip>
                            <SymbolIcon Symbol="Rotate"/>
                        </Button>

                        <Button x:Name="flipHorizontally"
                            Grid.Column="2" 
                            Height="45"
                            Width="45"
                            Command="{x:Bind CanvasOperationCommand}"
                            CommandParameter="{x:Bind root:CanvasOperation.FlipHorizontally}">
                            <ToolTipService.ToolTip>
                                <ToolTip Placement="Mouse" l:Uids.Uid="Ui_SIG_CanvasSet_FlipHorizon_Content" Visibility="Visible" />
                            </ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xEA44;" />
                        </Button>

                        <Button x:Name="flipVertically"
                            Grid.Column="3" 
                            Height="45"
                            Width="45"
                            Command="{x:Bind CanvasOperationCommand}"
                            CommandParameter="{x:Bind root:CanvasOperation.FlipVertically}">
                            <ToolTipService.ToolTip>
                                <ToolTip Placement="Mouse" l:Uids.Uid="Ui_SIG_CanvasSet_FlipVertical_Content" Visibility="Visible" />
                            </ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xEA44;">
                                <FontIcon.RenderTransform>
                                    <RotateTransform CenterX="10" CenterY="10" Angle="90"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </layout:ArcExpander.Content>
    </layout:ArcExpander>
</arc:ArcUserControl>
