<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VirtualPaper.PlayerWeb.Core.WebView.Components.SlidingSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VirtualPaper.PlayerWeb.Core.WebView.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="SlidingSidePanel_Loaded"
    SizeChanged="SlidingSidePanel_SizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PreviewPanelBackgroundBrush" Color="#DCFAFAFA" />
                    <SolidColorBrush x:Key="PreviewPanelHandleBackgroundBrush" Color="#EAF3F3F3" />
                    <SolidColorBrush x:Key="PreviewPanelBorderBrush" Color="#33000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PreviewPanelBackgroundBrush" Color="#DC202020" />
                    <SolidColorBrush x:Key="PreviewPanelHandleBackgroundBrush" Color="#EA2A2A2A" />
                    <SolidColorBrush x:Key="PreviewPanelBorderBrush" Color="#4DFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PreviewPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PreviewPanelHandleBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PreviewPanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" 
        VerticalAlignment="Top" 
        HorizontalAlignment="Right">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="TranslateXY" />
        </Grid.RenderTransform>

        <StackPanel Orientation="Horizontal">
            <Border x:Name="HandleArea"
                Width="30"
                Height="100"
                Background="{ThemeResource PreviewPanelHandleBackgroundBrush}"
                BorderBrush="{ThemeResource PreviewPanelBorderBrush}"
                BorderThickness="1,1,0,1"
                CornerRadius="8 0 0 8"
                Margin="0,0,-1,0"
                VerticalAlignment="Center"
                PointerPressed="Handle_PointerPressed"
                PointerReleased="Handle_PointerReleased"
                PointerMoved="Handle_PointerMoved">
                <TextBlock 
                    Text="≡"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="22"/>
            </Border>

            <Border x:Name="ContentArea"
                Width="340"
                Height="520"
                Background="{ThemeResource PreviewPanelBackgroundBrush}"
                BorderBrush="{ThemeResource PreviewPanelBorderBrush}"
                BorderThickness="1,1,0,1"
                CornerRadius="12,0,0,12">
                <ContentPresenter x:Name="PART_ContentPresenter"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
