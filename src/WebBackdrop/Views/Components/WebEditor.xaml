<?xml version="1.0" encoding="utf-8"?>
<arc:ArcUserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Components.WebEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Components"
    xmlns:tools="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:models="using:Workloads.Creation.WebBackdrop.Models"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="ArcUserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main editor area -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- File tabs -->
                <TabView x:Name="fileTabView"
                    TabWidthMode="SizeToContent"
                    CloseButtonOverlayMode="OnPointerOver"
                    TabItemsSource="{x:Bind ViewModel.OpenFiles, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.ActiveFile, Mode=TwoWay}"
                    TabCloseRequested="FileTabView_TabCloseRequested"
                    SelectionChanged="FileTabView_SelectionChanged">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="models:WebEditorFile">
                            <TabViewItem>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind FileName}" FontSize="12"/>
                                    <Ellipse
                                        Width="6" Height="6"
                                        Fill="{ThemeResource SystemAccentColor}"
                                        Visibility="{x:Bind IsSaved, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}"/>
                                </StackPanel>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>

                <!-- Monaco editor -->
                <local:MonacoEditor x:Name="monacoEditor"
                    Grid.Row="1"
                    Content="{x:Bind ViewModel.ActiveFile.Content, Mode=TwoWay}"
                    Language="{x:Bind ActiveFileLanguage, Mode=OneWay}"
                    ContentChanged="MonacoEditor_ContentChanged"/>
            </Grid>

            <!-- Right tool panel -->
            <Grid x:Name="toolPanel"
                Grid.Column="1"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1 0 0 0"
                Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <tools:WebToolListControl
                    x:Name="toolList"
                    ToolItems="{x:Bind ViewModel.ToolItems, Mode=OneWay}"
                    SelectedTool="{x:Bind SelectedTool, Mode=TwoWay}"
                    ToolListLoaded="ToolList_ToolListLoaded"/>

                <Grid x:Name="toolPanelHost" Grid.Column="1"/>
            </Grid>
        </Grid>

        <!-- Bottom status bar -->
        <tools:WebStatusBarControl x:Name="statusBar"
            Grid.Row="1"
            ActiveFilePath="{x:Bind ActiveFilePathText, Mode=OneWay}"
            ActiveFileLanguage="{x:Bind ActiveFileLanguage, Mode=OneWay}"
            PreviewRequested="StatusBar_PreviewRequested"/>
    </Grid>
</arc:ArcUserControl>
