<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebFileTreeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:models="using:Workloads.Creation.WebBackdrop.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:collection="using:VirtualPaper.UIComponent.Collection"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="FolderTemplate" x:DataType="models:WebFileItem">
            <collection:ArcTreeViewItem AutomationProperties.Name="{x:Bind FileName}"
                ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <collection:ArcTreeViewItem.ContextFlyout>
                    <MenuFlyout Opening="FolderMenuFlyout_Opening">
                        <MenuFlyoutItem Text="New File" Tag="{x:Bind}" Click="NewFileMenuItem_Click"/>
                        <MenuFlyoutItem Text="New Folder" Tag="{x:Bind}" Click="NewFolderMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Cut" Tag="{x:Bind}" Click="CutMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy" Tag="{x:Bind}" Click="CopyMenuItem_Click"/>
                        <MenuFlyoutItem x:Name="pasteMenuItem" Text="Paste" Tag="{x:Bind}" Click="PasteMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy Path" Tag="{x:Bind}" Click="CopyPathMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy Relative Path" Tag="{x:Bind}" Click="CopyRelativePathMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Rename" Tag="{x:Bind}" Click="RenameMenuItem_Click"/>
                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="DeleteMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Reveal in Explorer" Tag="{x:Bind}" Click="RevealInExplorerMenuItem_Click"/>
                    </MenuFlyout>
                </collection:ArcTreeViewItem.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        UseLayoutRounding="True"
                        Source="{x:Bind FolderIconSource, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind FileName}" />
                </StackPanel>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="models:WebFileItem">
            <collection:ArcTreeViewItem Margin="2 0 0 0" AutomationProperties.Name="{x:Bind FileName}" HorizontalContentAlignment="Stretch">
                <collection:ArcTreeViewItem.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Cut" Tag="{x:Bind}" Click="CutMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy" Tag="{x:Bind}" Click="CopyMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy Path" Tag="{x:Bind}" Click="CopyPathMenuItem_Click"/>
                        <MenuFlyoutItem Text="Copy Relative Path" Tag="{x:Bind}" Click="CopyRelativePathMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Rename" Tag="{x:Bind}" Click="RenameMenuItem_Click"/>
                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="DeleteMenuItem_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Reveal in Explorer" Tag="{x:Bind}" Click="RevealInExplorerMenuItem_Click"/>
                    </MenuFlyout>
                </collection:ArcTreeViewItem.ContextFlyout>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            UseLayoutRounding="True"
                            Source="{x:Bind IconSource}"/>
                        <TextBlock Text="{x:Bind FileName}"/>
                    </StackPanel>
                    <Border
                        Margin="10 0"
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="2"
                        Visibility="{x:Bind IsSaved, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!}">
                        <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemAccentColor}"/>
                    </Border>
                </Grid>
            </collection:ArcTreeViewItem>
        </DataTemplate>

        <local:WebFileItemTemplateSelector
            x:Key="WebFileItemTemplateSelector"
            FolderTemplate="{StaticResource FolderTemplate}"
            FileTemplate="{StaticResource FileTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <collection:ArcTreeView x:Name="fileTreeView"
            CancelSelectionEnable="False"
            SelectedItem="{x:Bind SelectedFileItem, Mode=TwoWay}"
            ItemsSource="{x:Bind _viewModel.FileItems}"
            ItemTemplateSelector="{StaticResource WebFileItemTemplateSelector}"
            ItemInvoked="FileTreeView_ItemInvoked"/>
    </Grid>
</UserControl>
