<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.DraftPanel.Views.WorkSpace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VirtualPaper.DraftPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cmd="using:VirtualPaper.UIComponent.Command"
    xmlns:navi="using:VirtualPaper.UIComponent.Navigation"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    xmlns:markup="using:VirtualPaper.UIComponent.ArcMarkupExtension"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <cmd:KeepToLeft x:Key="LeftMenuItems">
            <MenuBarItem Title="{markup:I18n Key=Project_StaticImg_MenuBar_Text_File}" KeyboardAcceleratorPlacementMode="Hidden">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="F"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_CreateNew}" Click="MFI_CreateNew_Clicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{markup:I18n Key=Project_Open}" Command="{x:Bind _viewModel.MFI_OpenCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{markup:I18n Key=Text_Save}" Command="{x:Bind _viewModel.MFI_SaveCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="saveAsMenuItem" Text="{markup:I18n Key=Text_Save_As}" Command="{x:Bind _viewModel.MFI_SaveAsCommand}"/>
                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_SaveAll}" Command="{x:Bind _viewModel.MFI_SaveAllCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="ExportMenuSubItem" Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Export}">
                    <MenuFlyoutItem x:Name="ExportPngMenuItem" Text="PNG" Tag="Png" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportBmpMenuItem" Text="BMP" Tag="Bmp" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportJpegMenuItem" Text="JPEG" Tag="Jpeg" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportJpegXrMenuItem" Text="JPEG XR" Tag="JpegXR" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportFullZipMenuItem" Text="Full Project Archive (.zip)" Tag="FullZip" Click="OnExportMenuItemClick"/>
                    <MenuFlyoutItem x:Name="ExportZipMenuItem" Text="Web Wallpaper Package (.zip)" Tag="Zip" Click="OnExportMenuItemClick"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="{markup:I18n Key=Text_ImportLib}" Click="OnAddToLibraryMenuItemClick"/>
                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Exit}" Click="MFI_Exit_Clicked">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F4"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="EditMenuBarItem" Title="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Edit}"
                KeyboardAcceleratorPlacementMode="Hidden" PointerEntered="EditMenuBarItem_PointerEntered">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="E"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Undo}" Command="{x:Bind _viewModel.MFI_UndoCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Redo}" Command="{x:Bind _viewModel.MFI_RedoCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="Z"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator x:Name="WebEditFileSeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebCutMenuItem" Text="Cut" Tag="Cut" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+X" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyMenuItem" Text="Copy" Tag="Copy" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebPasteMenuItem" Text="Paste" Tag="Paste" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+V" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyPathMenuItem" Text="Copy Path" Tag="CopyPath" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Shift+Alt+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyRelativePathMenuItem" Text="Copy Relative Path" Tag="CopyRelativePath" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+C" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="WebEditModifySeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebRenameMenuItem" Text="Rename..." Tag="Rename" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="F2" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebDeleteMenuItem" Text="Delete" Tag="Delete" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Del" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="WebEditFindSeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="WebFindMenuItem" Text="Find" Tag="Find" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+P" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebFindInFilesMenuItem" Text="Find in Files" Tag="FindInFiles" Visibility="Collapsed"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+F" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="F"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="WebSelectionMenuBarItem" Title="Selection" Visibility="Collapsed"
                KeyboardAcceleratorPlacementMode="Hidden" PointerEntered="EditMenuBarItem_PointerEntered">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="S"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem x:Name="WebNavigateBackMenuItem" Text="Go Back" Tag="NavigateBack"
                    KeyboardAcceleratorTextOverride="Alt+Left" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Left"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebNavigateForwardMenuItem" Text="Go Forward" Tag="NavigateForward"
                    KeyboardAcceleratorTextOverride="Alt+Right" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Right"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="WebCopyLineUpMenuItem" Text="Copy Line Up" Tag="CopyLineUp"
                    KeyboardAcceleratorTextOverride="Shift+Alt+Up" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="Up"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebCopyLineDownMenuItem" Text="Copy Line Down" Tag="CopyLineDown"
                    KeyboardAcceleratorTextOverride="Shift+Alt+Down" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu, Shift" Key="Down"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebMoveLineUpMenuItem" Text="Move Line Up" Tag="MoveLineUp"
                    KeyboardAcceleratorTextOverride="Alt+Up" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Up"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WebMoveLineDownMenuItem" Text="Move Line Down" Tag="MoveLineDown"
                    KeyboardAcceleratorTextOverride="Alt+Down" Click="WebEditMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Down"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </cmd:KeepToLeft>

        <cmd:KeepToRight x:Key="RightMenuItems">
            <MenuBarItem Title="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Help}" KeyboardAcceleratorPlacementMode="Hidden">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="H"/>
                </MenuBarItem.KeyboardAccelerators>

                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_Manual}" Command="{x:Bind _viewModel.MFI_ManualCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="None" Key="M"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>

                <MenuFlyoutItem Text="{markup:I18n Key=Project_StaticImg_MenuBar_Text_About}" Command="{x:Bind _viewModel.MFI_AboutCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="None" Key="A"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </cmd:KeepToRight>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="menuContent"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <cmd:ObservableMenuBar
                    Grid.ColumnSpan="3"
                    KeepToLeft="{StaticResource LeftMenuItems}"
                    KeepToRight="{StaticResource RightMenuItems}"
                    MiddleItems="{x:Bind _viewModel._middleMenuItems}"/>
                <ContentControl x:Name="runtimeTopBarContent"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </ContentControl>

        <Grid x:Name="contentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabView x:Name="TabViewControl"
                Loaded="TabViewControl_Loaded"
                TabWidthMode="SizeToContent"
                SelectedIndex="{x:Bind _viewModel.SelectedTabIndex, Mode=TwoWay}"
                TabItemsSource="{x:Bind _viewModel.TabViewItems}"
                CloseButtonOverlayMode="OnPointerOver"
                TabItemsChanged="TabViewControl_TabItemsChanged"   
                SelectionChanged="TabViewControl_SelectionChanged"
                AddTabButtonClick="TabViewControl_AddTabButtonClick"
                TabCloseRequested="TabViewControl_TabCloseRequested" />

            <Grid x:Name="workspaceContentPool" Grid.Row="1" />
        </Grid>

        <Grid x:Name="maskGrid" 
            Grid.RowSpan="2" 
            Background="#80000000" 
            Visibility="Collapsed"
            Tapped="MaskGrid_Tapped">

            <Frame x:Name="overlayFrame" 
                Width="970" 
                Height="680"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Tapped="OverlayFrame_Tapped"/>
        </Grid>
    </Grid>
</arc:ArcPage>
