<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.AppSettingsPanel.Views.PerformanceSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.AppSettingsPanel.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollView>
        <StackPanel Margin="16 12 16 16" Spacing="16" Orientation="Vertical">
            <StackPanel Spacing="8">
                <Grid MinHeight="90" Padding="20 16" ColumnSpacing="20"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock l:Uids.Uid="Ui_Settings_Performance_HardwareAcceleration" TextWrapping="Wrap"/>
                        <TextBlock l:Uids.Uid="Ui_Settings_Performance_HardwareAccelerationExplain" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OffContent="" OnContent=""
                        IsOn="{x:Bind _viewModel.UiHardwareAccelerationEnabled, Mode=TwoWay}"
                        AutomationProperties.AutomationId="Settings.Performance.HardwareAcceleration"
                        l:Uids.Uid="Ui_Settings_Performance_HardwareAccelerationToggle"/>
                </Grid>
                <InfoBar IsOpen="{x:Bind _viewModel.IsUiRestartRequired, Mode=OneWay}" IsClosable="False"
                    Severity="Informational" l:Uids.Uid="Ui_Settings_Performance_HardwareAccelerationRestart"
                    AutomationProperties.AutomationId="Settings.Performance.HardwareAccelerationRestart"/>
            </StackPanel>

            <StackPanel x:Name="Play" Spacing="8" Orientation="Vertical">
                <TextBlock x:Name="PlayHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_Perforemance_Text_Play_Text"
                    FontWeight="Bold"/>

                <Grid
                    x:Name="OthersFullScreen"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE7B5;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_Play_OthersFullScreen_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_Play_OthersFullScreenExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="OthersFullScreenPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.Fullscreen"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.PlayStatus}"
                        SelectedIndex="{x:Bind _viewModel.SelectedFullScreenPlayStatuIndex, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid x:Name="OthersFocus"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xED35;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_Play_OthersFocus_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_Play_OthersFocusExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="OthersFocusPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.Focus"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.PlayStatus}"
                        SelectedIndex="{x:Bind _viewModel.SelectedFocusPlayStatuIndex, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid x:Name="Audio"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xED1F;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_Play_Audio_Text"/>
                    </Grid>

                    <ToggleButton
                        AutomationProperties.AutomationId="Settings.Performance.AudioOnlyOnDesktop"
                        Grid.Column="2"
                        Width="200"
                        Content="{x:Bind _viewModel.AudioStatu, Mode=OneWay}" 
                        IsChecked="{x:Bind _viewModel.IsAudioOnlyOnDesktop, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="Laptop"
                Spacing="8"
                Orientation="Vertical">

                <TextBlock x:Name="LaptopHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_Perforemance_Text_Laptop_Text"
                    FontWeight="Bold"/>

                <Grid x:Name="BatteryPoweredn"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xEBA7;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_Laptop_BatteryPoweredn_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_Laptop_BatteryPowerednExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="BatteryPowerednPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.Battery"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.PlayStatus}"
                        SelectedIndex="{x:Bind _viewModel.SelectedBatteryPowerednPlayStatuIndex, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid x:Name="PowerSaving"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xEBB9;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_Laptop_PowerSaving_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_Laptop_PowerSavingExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="PowerSavingPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.PowerSaving"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.PlayStatus}"
                        SelectedIndex="{x:Bind _viewModel.SelectedPowerSavingPlayStatuIndex, Mode=TwoWay}"
                        Width="200" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="System"
                Spacing="8"
                Orientation="Vertical">

                <TextBlock x:Name="SystemHeader"
                    Margin="0"
                    l:Uids.Uid="Ui_Settings_Perforemance_Text_System_Text"
                    FontWeight="Bold"/>

                <Grid x:Name="RemoteDesktop"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE703;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_System_RemoteDesktop_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_System_RemoteDesktopExplain_Text"/>
                    </Grid>

                    <ComboBox x:Name="RemoteDesktopPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.RemoteDesktop"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.PlayStatus}"
                        SelectedIndex="{x:Bind _viewModel.SelectedRemoteDesktopPlayStatuIndex, Mode=TwoWay}"
                        Width="200" />
                </Grid>

                <Grid x:Name="StatuMechanism"
                    Height="90"
                    Margin="0"
                    Padding="20 0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="0 0 20 0" Glyph="&#xE7F4;"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock l:Uids.Uid="Ui_Settings_Perforemance_System_StatuMechanism_Text"/>
                        <TextBlock 
                            Grid.Row="1" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_System_StatuMechanismExplain_ForPer_Text"/>
                        <TextBlock 
                            Grid.Row="2" 
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            l:Uids.Uid="Ui_Settings_Perforemance_System_StatuMechanismExplain_ForAll_Text"/>
                    </Grid>

                    <ComboBox x:Name="StatuMechanismPlayStatusCombo"
                        AutomationProperties.AutomationId="Settings.Performance.MonitorPolicy"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind _viewModel.StatuMechanisms}"
                        SelectedIndex="{x:Bind _viewModel.SelectedStatuMechanismPlayStatuIndex, Mode=TwoWay}"
                        Width="200"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
