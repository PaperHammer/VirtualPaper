<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VirtualPaper.WpSettingsPanel.Views.UnsupportedImportFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer">
    <Grid RowSpacing="16" MaxWidth="640">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" l:Uids.Uid="Ui_WpLib_UnsupportedFilesDescription"/>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Files}" Height="{x:Bind ListHeight}"
            SelectionMode="None" HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="Library.Import.UnsupportedFiles"
            ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <HyperlinkButton Tag="{Binding}" Click="RevealFile_Click" Padding="0,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding}" ToolTipService.ToolTip="{Binding}"
                            AutomationProperties.AutomationId="Library.Import.RevealFile" l:Uids.Uid="Ui_WpLib_RevealUnsupportedFile">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                    </HyperlinkButton>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
