<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VirtualPaper.IntelligentPanel.Views.StyleTransferComp.StyleTransferTasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:VirtualPaper.UIComponent.Layout"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.IntelligentPanel.Views.StyleTransferComp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lcl_models="using:VirtualPaper.IntelligentPanel.Models"
    xmlns:input="using:VirtualPaper.UIComponent.Input"
    mc:Ignorable="d">

    <Grid Margin="12">
        <ListView x:Name="TaskListView"
            ItemsSource="{x:Bind Tasks}"
            SelectionMode="None"
            IsItemClickEnabled="False"
            Padding="0 0 16 0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lcl_models:StyleTransferTaskItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <layout:ArcExpander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="20 0"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                            BorderThickness="1">

                            <layout:ArcExpander.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Padding="0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="8">
                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock 
                                                    l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Text"
                                                    FontSize="14" 
                                                    MaxWidth="160" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1"
                                                    Text="{x:Bind SourceFilePath}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1"
                                                    VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock
                                                    l:Uids.Uid="Ui_Intelligent_Task_Style_Text"
                                                    FontSize="14"
                                                    MaxWidth="160" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1"
                                                    Text="{x:Bind StyleName, Mode=OneWay}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1"
                                                    VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="20,0,16,0"
                                            Spacing="2">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    TextWrapping="Wrap" MaxWidth="240"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind StatusColor, Mode=OneWay, Converter={StaticResource ByteArrayToBrushConverter}}"/>
                                                <Border CornerRadius="4" Padding="6 2" HorizontalAlignment="Left"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                                                    <TextBlock AutomationProperties.AutomationId="Intelligent.Task.Preservation"
                                                        Text="{x:Bind PreservationText, Mode=OneWay}" FontSize="12"
                                                        TextWrapping="Wrap" MaxWidth="240"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        l:Uids.Uid="Ui_Intelligent_Result_PreservationTooltip"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Column="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <input:ArcButton Command="{x:Bind PreviewCommand}"
                                                Height="Auto" MinHeight="32" MinWidth="76" MaxWidth="220" Padding="12,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <TextBlock l:Uids.Uid="Ui_Text_Preview_Text" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </input:ArcButton>

                                            <input:ArcButton Grid.Column="1" Command="{x:Bind ImportCommand}"
                                                Height="Auto" MinHeight="32" MinWidth="76" MaxWidth="220" Padding="12,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <TextBlock l:Uids.Uid="Ui_Text_ImportLib_Text" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </input:ArcButton>

                                            <input:ArcButton Grid.Column="2" Command="{x:Bind SaveCommand}"
                                                Height="Auto" MinHeight="32" MinWidth="76" MaxWidth="220" Padding="12,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <TextBlock l:Uids.Uid="Ui_Text_Save_Text" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </input:ArcButton>

                                            <input:ArcButton
                                                Grid.Column="3" Height="Auto" MinHeight="32" MinWidth="76" MaxWidth="220" Padding="12,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{x:Bind RemoveCommand}"
                                                BorderBrush="#FFE0B0B0"
                                                Background="#20FF4D6A"
                                                Foreground="#FFD13438">
                                                <TextBlock l:Uids.Uid="Ui_Text_Delete_Text" FontSize="14" Foreground="#FFD13438" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </input:ArcButton>
                                        </Grid>
                                    </Grid>

                                    <ProgressBar
                                        Grid.Row="1"
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                        ShowError="{x:Bind IsShowError, Mode=OneWay}"
                                        Value="{x:Bind Progress, Mode=OneWay}"
                                        Foreground="{x:Bind StatusColor, Mode=OneWay, Converter={StaticResource ByteArrayToBrushConverter}}"
                                        Height="3"
                                        Width="360"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"/>
                                </Grid>
                            </layout:ArcExpander.Header>

                            <layout:ArcExpander.Content>
                                <StackPanel
                                    Padding="16,12"
                                    MinHeight="120"
                                    Spacing="10">
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel HorizontalAlignment="Center" Spacing="6">

                                            <TextBlock 
                                                l:Uids.Uid="Ui_Intelligent_Task_Scr_Img_Text"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"/>

                                            <Grid>
                                                <Rectangle
                                                    RadiusX="14"
                                                    RadiusY="14"
                                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeDashArray="4 3"
                                                    Fill="Transparent"/>

                                                <Border x:Name="sourceImageBorder"
                                                    Width="400"
                                                    Height="250"
                                                    Margin="10"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Image x:Name="sourceImage"
                                                        Stretch="UniformToFill"
                                                        Source="{x:Bind SourceFilePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel 
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="16">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE809;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock 
                                                        Text="{x:Bind SourceResolution}" 
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock 
                                                        Text="{x:Bind SourceFileSize, Mode=OneWay}" 
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock 
                                                        Text="{x:Bind SourceFileExt, Mode=OneWay}" 
                                                        FontSize="14" 
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel 
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Spacing="6">

                                            <Grid HorizontalAlignment="Stretch">
                                                <TextBlock 
                                                    l:Uids.Uid="Ui_Intelligent_Task_Style_Text"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid>
                                                <Rectangle
                                                    RadiusX="14"
                                                    RadiusY="14"
                                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeDashArray="4 3"
                                                    Fill="Transparent"/>

                                                <Border x:Name="styleImageBorder"
                                                    Width="300"
                                                    Height="250"
                                                    Margin="10"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Image x:Name="styleImage"
                                                        Stretch="UniformToFill"
                                                        Source="{x:Bind StyleFilePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel 
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Spacing="16">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <Grid>
                                                            <TextBlock x:Name="styleName"
                                                                Text="{x:Bind StyleName, Mode=OneWay}"
                                                                Visibility="{x:Bind StyleName, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=HasValue}"
                                                                FontSize="14"
                                                                MaxWidth="120"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock x:Name="styleNameFallback"
                                                                l:Uids.Uid="Ui_Intelligent_Task_Style_Img_Import_Text"
                                                                Visibility="{x:Bind StyleName, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}, ConverterParameter=!HasValue}"
                                                                FontSize="14"
                                                                MaxWidth="120"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock 
                                                            Text="{x:Bind StyleFileSize, Mode=OneWay}" 
                                                            FontSize="14"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock 
                                                            Text="{x:Bind StyleFileExt, Mode=OneWay}" 
                                                            FontSize="14" 
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel HorizontalAlignment="Center" Spacing="6">

                                        <TextBlock 
                                            l:Uids.Uid="Ui_Text_Result_Text"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"/>

                                        <Grid>
                                            <Rectangle
                                                RadiusX="14"
                                                RadiusY="14"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeThickness="1.5"
                                                StrokeDashArray="4 3"
                                                Fill="Transparent"/>

                                            <Border x:Name="resultImageBorder"
                                                Width="400"
                                                Height="250"
                                                Margin="10"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                                <Image x:Name="resultImage"
                                                    Stretch="UniformToFill"
                                                    Source="{x:Bind ResultFilePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel 
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE809;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock 
                                                    Text="{x:Bind ResultResolution, Mode=OneWay}" 
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEB05;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock 
                                                    Text="{x:Bind ResultFileSize, Mode=OneWay}" 
                                                    FontSize="14"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock 
                                                    Text="{x:Bind ResultFileExt, Mode=OneWay}" 
                                                    FontSize="14" 
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </layout:ArcExpander.Content>
                        </layout:ArcExpander>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
