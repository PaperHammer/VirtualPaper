<?xml version="1.0" encoding="utf-8"?>
<arc:ArcUserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Components.WebEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Components"
    xmlns:editorContent="using:Workloads.Creation.WebBackdrop.Views.Components.EditorContent"
    xmlns:bottomPanels="using:Workloads.Creation.WebBackdrop.Views.Components.BottomPanels"
    xmlns:tools="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:models="using:Workloads.Creation.WebBackdrop.Models"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    xmlns:utils="using:VirtualPaper.UIComponent.Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"  
    Loaded="ArcUserControl_Loaded"
    Unloaded="ArcUserControl_Unloaded">

    <arc:ArcUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///WebBackdrop/Themes/WebBackdropColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </arc:ArcUserControl.Resources>

    <arc:ArcUserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="J" Invoked="KeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="KeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control,Menu" Key="B" Invoked="KeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="QuickOpenKeyboardAccelerator_Invoked"/>
    </arc:ArcUserControl.KeyboardAccelerators>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Height="38" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <AutoSuggestBox
                x:Name="quickOpenBox"
                Width="480"
                MaxWidth="560"
                Height="30"
                HorizontalAlignment="Center"
                PlaceholderText="Search files by name (Ctrl+P)"
                TextMemberPath="FileName"
                TextChanged="QuickOpenBox_TextChanged"
                QuerySubmitted="QuickOpenBox_QuerySubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WebQuickOpenItem">
                        <Grid MinWidth="400" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind RelativePath}" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Grid>

        <Grid x:Name="editorGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="leftSideBarColumn" Width="260"/>
                <ColumnDefinition/>
                <ColumnDefinition x:Name="rightSideBarColumn" Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid x:Name="leftSideBar" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <tools:WebFileTreeControl x:Name="leftFileTreeControl"
                        FileOpenRequested="FileTree_FileOpenRequested"
                        FileSaveRequested="FileTree_FileSaveRequested"
                        FileSaveAsRequested="FileTree_FileSaveAsRequested"
                        ContentMatchOpenRequested="FileTree_ContentMatchOpenRequested"
                        ActiveFileMoved="FileTree_ActiveFileMoved"
                        FolderSelected="FileTree_FolderSelected"/>

                    <Rectangle x:Name="leftSideBarBorderLine"
                        Width="1"
                        HorizontalAlignment="Right"
                        Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                </Grid>

                <Grid x:Name="leftSideBarSplitter"
                    Width="7"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    ManipulationMode="None"
                    PointerPressed="LeftSideBarSplitter_PointerPressed"
                    PointerMoved="Splitter_PointerMoved"
                    PointerReleased="Splitter_PointerReleased"
                    PointerCanceled="Splitter_PointerReleased"
                    PointerCaptureLost="Splitter_PointerCaptureLost"
                    PointerEntered="Splitter_PointerEntered"
                    PointerExited="Splitter_PointerExited"
                    utils:CursorUtil.CursorShape="SizeWestEast">

                    <Rectangle x:Name="leftSideBarSplitterLine"
                        Width="4"
                        HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0 0 0 1">
                    <editorContent:WebEditorContentView x:Name="editorContentView"
                        ContentModified="EditorContentView_ContentModified"
                        CursorPositionChanged="EditorContentView_CursorPositionChanged"
                        MarkersChanged="EditorContentView_MarkersChanged"
                        ShortcutRequested="EditorContentView_ShortcutRequested"
                        EditorStateChanged="EditorContentView_EditorStateChanged"/>
                </Border>

                <Grid x:Name="bottomPanel"
                    Grid.Row="1"
                    Height="240"
                    MinHeight="40"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0 1 0 0"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <SelectorBar x:Name="bottomPanelSelectorBar"
                            SelectionChanged="BottomPanelSelectorBar_SelectionChanged">
                            <SelectorBarItem Text="PROBLEMS" Padding="12 6" Tag="{x:Bind local:WebEditorBottomPanel.Problems, Mode=OneTime}" IsSelected="True"/>
                            <!--<SelectorBarItem Text="OUTPUT" Padding="8" Tag="{x:Bind local:WebEditorBottomPanel.Output, Mode=OneTime}"/>-->
                        </SelectorBar>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Padding="8 0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Click="BottomPanelClose_Click">
                            <FontIcon Glyph="&#xE921;" FontSize="12"/>
                        </Button>
                    </Grid>
                    
                    <Grid Grid.Row="2">
                        <bottomPanels:WebProblemsPanelControl x:Name="problemsPanel"
                            Visibility="Collapsed"
                            ProblemRequested="ProblemsPanel_ProblemRequested"/>
                        <TextBlock x:Name="bottomPanelContent"
                            Margin="12"
                            FontSize="12"
                            Opacity="0.7"/>
                    </Grid>
                    
                    <Rectangle x:Name="bottomSideBarBorderLine"
                        Height="1"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <Grid x:Name="bottomSideBarSplitter"
                        Height="7"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Visibility="Collapsed"
                        ManipulationMode="None"
                        PointerPressed="BottomSideBarSplitter_PointerPressed"
                        PointerMoved="Splitter_PointerMoved"
                        PointerReleased="Splitter_PointerReleased"
                        PointerCanceled="Splitter_PointerReleased"
                        PointerCaptureLost="Splitter_PointerCaptureLost"
                        PointerEntered="Splitter_PointerEntered"
                        PointerExited="Splitter_PointerExited"
                        utils:CursorUtil.CursorShape="SizeNorthSouth">

                        <Rectangle x:Name="bottomSideBarSplitterLine"
                            Height="4"
                            VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="rightSideBar"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <tools:WebPropertyPanelControl x:Name="propertyPanelControl"/>

                <Rectangle x:Name="rightSideBarBorderLine"
                    Width="1"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>

                <Grid x:Name="rightSideBarSplitter"
                    Width="7"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    ManipulationMode="None"
                    PointerPressed="RightSideBarSplitter_PointerPressed"
                    PointerMoved="Splitter_PointerMoved"
                    PointerReleased="Splitter_PointerReleased"
                    PointerCanceled="Splitter_PointerReleased"
                    PointerCaptureLost="Splitter_PointerCaptureLost"
                    PointerEntered="Splitter_PointerEntered"
                    PointerExited="Splitter_PointerExited"
                    utils:CursorUtil.CursorShape="SizeWestEast">

                    <Rectangle x:Name="rightSideBarSplitterLine"
                        Width="4"
                        HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <tools:WebStatusBarControl x:Name="statusBar"                
                ActiveFileLanguage="{x:Bind ActiveFileLanguage, Mode=OneWay}"
                LineNumber="{x:Bind CursorLineNumber, Mode=OneWay}"
                Column="{x:Bind CursorColumn, Mode=OneWay}"
                SelectedCharacterCount="{x:Bind SelectedCharacterCount, Mode=OneWay}"
                IsSelectedCharacterCountOverflow="{x:Bind IsSelectedCharacterCountOverflow, Mode=OneWay}"
                ProblemErrorCount="{x:Bind ProblemErrorCount, Mode=OneWay}"
                ProblemWarningCount="{x:Bind ProblemWarningCount, Mode=OneWay}"
                IsSaving="{x:Bind IsSaving, Mode=OneWay}"
                IndentText="{x:Bind IndentText, Mode=OneWay}"
                EncodingText="{x:Bind EncodingText, Mode=OneWay}"
                LineEndingText="{x:Bind LineEndingText, Mode=OneWay}"
                IsTextFile="{x:Bind ActiveFileIsText, Mode=OneWay}"
                PanelRequested="StatusBar_PanelRequested"
                RunRequested="StatusBar_RunRequested"
                ToggleLeftSideBarRequested="StatusBar_ToggleLeftSideBarRequested"
                ToggleBottomPanelRequested="StatusBar_ToggleBottomPanelRequested"
                ToggleRightSideBarRequested="StatusBar_ToggleRightSideBarRequested"
                IndentChanged="StatusBar_IndentChanged"
                EncodingChanged="StatusBar_EncodingChanged"
                LineEndingChanged="StatusBar_LineEndingChanged"/>

            <Rectangle x:Name="bottomStatusSideBarBorderLine"
                Height="1"
                VerticalAlignment="Top"
                Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Grid>
    </Grid>
</arc:ArcUserControl>
