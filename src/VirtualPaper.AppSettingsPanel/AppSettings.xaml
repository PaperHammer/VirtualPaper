<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.AppSettingsPanel.AppSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.AppSettingsPanel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <SelectorBar x:Name="SelBar"
            SelectionChanged="SelectorBar_SelectionChanged"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            HorizontalAlignment="Stretch">
            <SelectorBarItem l:Uids.Uid="Ui_AppSettings_SelBarItem1_General_Text" Tag="GeneralView" IsSelected="True"
                AutomationProperties.AutomationId="Settings.Tab.General"/>
            <SelectorBarItem l:Uids.Uid="Ui_AppSettings_SelBarItem2_Performance_Text" Tag="PerformanceView"
                AutomationProperties.AutomationId="Settings.Tab.Performance"/>
            <SelectorBarItem l:Uids.Uid="Ui_AppSettings_SelBarItem3_System_Text" Tag="SystemView"
                AutomationProperties.AutomationId="Settings.Tab.System"/>
            <SelectorBarItem l:Uids.Uid="Ui_AppSettings_SelBarItem4_Others_Text" Tag="OthersView"
                AutomationProperties.AutomationId="Settings.Tab.Others"/>
        </SelectorBar>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</arc:ArcPage>
