<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.StaticImg.Views.Tools.EraserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:VirtualPaper.UIComponent.Layout"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Workloads.Creation.StaticImg.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <layout:ArcExpander Style="{StaticResource RightExpanderStyle}">
        <layout:ArcExpander.Header>
            <TextBlock l:Uids.Uid="Ui_Project_StaticImg_Text_Eraser_Text"/>
        </layout:ArcExpander.Header>
        <layout:ArcExpander.Content>
            <StackPanel
                Spacing="10"
                Orientation="Vertical">
                <StackPanel
                    Spacing="4"
                    Orientation="Vertical">
                    <StackPanel
                        Spacing="4"
                        Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock 
                                VerticalAlignment="Center"
                                FontSize="12"
                                l:Uids.Uid="Ui_Project_StaticImg_Text_WidthPixel_Text"/>

                            <TextBox
                                x:Name="eraserSizeTextBox"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                TextChanging="EraserSizeTextBox_Changing"
                                LostFocus="EraserSizeTextBox_LostFocus"
                                Text="{x:Bind EraserSize, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>

                    <Slider
                        x:Name="eraserSizeSlider"
                        Value="{x:Bind EraserSize, Mode=TwoWay}"
                        Minimum="1"
                        Maximum="100"
                        IsThumbToolTipEnabled="False"/>
                </StackPanel>

                <StackPanel
                    Spacing="4"
                    Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="12"
                            l:Uids.Uid="Ui_Project_StaticImg_Text_OpacityPercent_Text"/>

                        <TextBox
                            x:Name="eraserOpacityTextBox"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            TextChanging="EraserOpacityTextBox_Changing"
                            LostFocus="EraserOpacityTextBox_LostFocus"
                            Text="{x:Bind EraserOpacity, Mode=OneWay}"/>
                    </Grid>

                    <Slider
                        x:Name="eraserOpacitySlider"
                        Value="{x:Bind EraserOpacity, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        IsThumbToolTipEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </layout:ArcExpander.Content>
    </layout:ArcExpander>
</UserControl>
