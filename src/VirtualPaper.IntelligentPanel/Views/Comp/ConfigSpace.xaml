<?xml version="1.0" encoding="utf-8"?>
<arc:ArcPage
    x:Class="VirtualPaper.IntelligentPanel.Views.Comp.ConfigSpace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:VirtualPaper.IntelligentPanel.Views.Comp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:VirtualPaper.UIComponent.Data"
    xmlns:input="using:VirtualPaper.UIComponent.Input"
    xmlns:arc="using:VirtualPaper.UIComponent.Templates"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded"
    NavigationCacheMode="Enabled">

    <data:Card x:Name="ConfigSpaceCard"
        Padding="32"
        Elevation="64"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid x:Name="ConfigSpaceGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Stretch">
                <Frame x:Name="FrameComp" Loaded="FrameComp_Loaded"/>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0" MaxWidth="480" HorizontalAlignment="Right" ColumnSpacing="6"
                Visibility="{x:Bind _viewModel.BtnVisible, Mode=OneWay, Converter={StaticResource VisibilityByValueConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <input:ArcButton
                        AutomationProperties.AutomationId="Intelligent.Task.Cancel"
                        Command="{x:Bind _viewModel.PreviousStepCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        MinWidth="120"
                        Height="Auto" MinHeight="36" Padding="16,8"
                        FontSize="14">
                        <TextBlock Text="{x:Bind _viewModel.PreviousStepBtnText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </input:ArcButton>

                    <input:ArcButton Grid.Column="1"
                        AutomationProperties.AutomationId="Intelligent.Task.Confirm"
                        IsEnabled="{x:Bind _viewModel.IsNextEnable, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        MinWidth="120"
                        Height="Auto" MinHeight="36" Padding="16,8"
                        Command="{x:Bind _viewModel.NextStepCommand}"
                        FontSize="14"
                        Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="{x:Bind _viewModel.NextStepBtnText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </input:ArcButton>
            </Grid>

            <InfoBar x:Name="RunningAsAdminWarning"
                Grid.Row="0"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{x:Bind _viewModel.IsElevated}"
                l:Uids.Uid="Ui_RunningAsAdminWarning_Message"
                Severity="Warning" />
        </Grid>
    </data:Card>
</arc:ArcPage>
