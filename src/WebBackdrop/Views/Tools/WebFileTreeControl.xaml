<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.WebBackdrop.Views.Tools.WebFileTreeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Workloads.Creation.WebBackdrop.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="FolderTemplate" x:DataType="local:WebFileItem">
            <TreeViewItem AutomationProperties.Name="{x:Bind FileName}"
                ItemsSource="{x:Bind Children}" IsExpanded="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        UseLayoutRounding="True"
                        Source="{StaticResource WebBackdrop_FileTree_Folder}"/>
                    <TextBlock Text="{x:Bind FileName}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="local:WebFileItem">
            <TreeViewItem AutomationProperties.Name="{x:Bind FileName}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        UseLayoutRounding="True"
                        Source="{x:Bind IconSource}"/>
                    <TextBlock Text="{x:Bind FileName}"/>
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <local:WebFileItemTemplateSelector
            x:Key="WebFileItemTemplateSelector"
            FolderTemplate="{StaticResource FolderTemplate}"
            FileTemplate="{StaticResource FileTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="8 6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Text="{x:Bind ProjectName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"/>
            <Button
                Grid.Column="1"
                Padding="4"
                BorderThickness="0"
                Background="Transparent"
                ToolTipService.ToolTip="New File"
                Click="NewFile_Click">
                <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
            </Button>
        </Grid>

        <TreeView
            Grid.Row="1"
            x:Name="fileTreeView"
            ItemsSource="{x:Bind DataSource, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource WebFileItemTemplateSelector}"
            ItemInvoked="FileTreeView_ItemInvoked"/>
    </Grid>
</UserControl>
