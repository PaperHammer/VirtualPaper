                    </Grid>

                    <CheckBox Content="锁定纵横比"/>-->

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button
                        l:Uids.Uid="Ui_Text_Cancel_Content"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Click="CropCancelBtn_Click"/>

                    <Button 
                        Grid.Column="2"
                        l:Uids.Uid="Ui_Text_Complete_Content"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="CropCommitBtn_Click"/>
                </Grid>
            </StackPanel>
        </Expander.Content>
    </Expander>
</UserControl>
