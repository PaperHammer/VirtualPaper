<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VirtualPaper.WpSettingsPanel.Views.AddToLib"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    AllowDrop="True"
    DragLeave="Page_DragLeave"
    DragOver="Page_DragOver"
    Drop="Page_Drop">
    <Page.Resources>
        <Style x:Key="ImportChoiceStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14 12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>
    <Grid MaxWidth="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DropGrid" Height="180"
            CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
            <Rectangle Margin="1" RadiusX="8" RadiusY="8"
                Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                StrokeDashArray="3" StrokeDashCap="Round" StrokeThickness="1"/>
            <StackPanel x:Name="AddPanel" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon FontSize="36" Glyph="&#xE8C8;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock l:Uids.Uid="Ui_Add_To_Lib_DragDropFile_Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel x:Name="AddPanelDrop" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon FontSize="36" Glyph="&#xE8C8;"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock l:Uids.Uid="Ui_Add_To_Lib_AddWallpaperDrop_Text"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </StackPanel>
            <InfoBar x:Name="RunningAsAdminWarning" Margin="5" IsClosable="False"
                IsOpen="{x:Bind _viewModel.IsElevated}"
                l:Uids.Uid="Ui_RunningAsAdminWarning_Message" Severity="Warning"/>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <Button x:Name="AddFilesButton" Style="{StaticResource ImportChoiceStyle}"
                AutomationProperties.AutomationId="Library.Import.Files"
                Command="{x:Bind _viewModel.HandleAddFilesCommand}"
                l:Uids.Uid="Ui_Add_To_Lib_SelectFiles_Explain_ToolTipService_ToolTip">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7C3;" FontSize="20" VerticalAlignment="Top" Margin="0 2 0 0"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock l:Uids.Uid="Ui_Add_To_Lib_SelectFiles_Text" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Ui_Add_To_Lib_SelectFiles_Explain_Text"
                            FontSize="12" LineHeight="16" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="AddFolderButton" Style="{StaticResource ImportChoiceStyle}"
                Command="{x:Bind _viewModel.HandleAddFoldersCommand}"
                l:Uids.Uid="Ui_Add_To_Lib_SelectFolderExplain_ToolTipService_ToolTip">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xED43;" FontSize="20" VerticalAlignment="Top" Margin="0 2 0 0"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock l:Uids.Uid="Ui_Add_To_Lib_SelectFolder_Text" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock l:Uids.Uid="Ui_Add_To_Lib_SelectFolderExplain_Text"
                            FontSize="12" LineHeight="16" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Page>
