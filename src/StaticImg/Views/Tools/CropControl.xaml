<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Workloads.Creation.StaticImg.Views.Tools.CropControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:Workloads.Creation.StaticImg.Views.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lcl_models="using:Workloads.Creation.StaticImg.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="AspectRatioTemplate" x:DataType="lcl_models:AspectRatioItem">
            <GridViewItem 
                Width="90" 
                Height="100" 
                Margin="6">
                <StackPanel Orientation="Vertical" Spacing="10">
                    <Border 
                        Width="{x:Bind BorderWidth}" 
                        Height="{x:Bind BorderHeight}"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="1">
                    </Border>
                    <TextBlock 
                        Text="{x:Bind DisplayText}" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
                </StackPanel>
            </GridViewItem>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="AspectRatioPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Expander Style="{StaticResource RightExpanderStyle}">
        <Expander.Header>
            <TextBlock l:Uids.Uid="Ui_Project_StaticImg_ToolName_Crop_Text"/>
        </Expander.Header>
        <Expander.Content>
            <StackPanel Orientation="Vertical" Spacing="6">

                <GridView 
                    SelectionMode="Single"
                    HorizontalAlignment="Stretch"
                    IsItemClickEnabled="True"
                    SelectedItem="{x:Bind SeletcedAspect, Mode=TwoWay}"
                    ItemsSource="{x:Bind AspectRatios}"
                    ItemTemplate="{StaticResource AspectRatioTemplate}"
                    ItemsPanel="{StaticResource AspectRatioPanel}"/>

